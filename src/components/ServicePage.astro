---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from './CTA.astro';
import Button from './Button.astro';
import RentalPricing from './RentalPricing.astro';
import { shell, section, pageHero, pageTitle, eyebrow as eyebrowClass, lede, split, splitImage, details, summary, phone } from '../styles/ui';
import { site, servicePageDefaults, pricingContent } from '../data/content';
import type { ServiceDetail } from '../data/content';

type Props = ServiceDetail;

const {
  title,
  eyebrow,
  intro,
  image,
  imageAlt = servicePageDefaults.defaultImageAlt,
  imageFocalPoint = 'center',
  imageCaption,
  quoteHref,
  included = [],
  includedHeading = servicePageDefaults.includedHeading,
  includedIntro = servicePageDefaults.includedIntro,
  who = '',
  options = [],
  optionsIntro,
  pricing = '',
  priceLabel,
  pricingRows,
  pricingFactors,
  faqs = []
} = Astro.props;
---
<BaseLayout title={`${title} | ${site.name}`} description={intro} quoteHref={quoteHref}>
  <section class={pageHero}>
    <div class:list={[shell, split]}>
      <div>
        <p class:list={[eyebrowClass, 'flex items-center gap-3']}><span class="h-px w-10 bg-sea" aria-hidden="true"></span>{eyebrow}</p>
        <h1 class={pageTitle}>{title}</h1>
        <p class:list={[lede, "mt-[18px]"]}>{intro}</p>
        <p class="mt-5 text-[1.2rem] font-bold text-sea-dark">{priceLabel}</p>
        <p class="mt-2 max-w-[640px] text-small">{priceLabel === 'Custom quote' ? pricing : pricingContent.note}</p>
        <div class="mt-6 flex flex-wrap items-center gap-control-gap">
          <Button href={quoteHref}>{servicePageDefaults.quoteButtonText} <span aria-hidden="true">→</span></Button>
          <a class={phone} href={site.phoneHref}>{servicePageDefaults.callButtonPrefix}{site.phoneDisplay}</a>
        </div>
      </div>
      {image && (
        <figure class="m-0">
          <img
            src={image}
            alt={imageAlt}
            class:list={[
              splitImage,
              imageFocalPoint === 'right' && 'object-[70%_center]',
              imageFocalPoint === 'left' && 'object-[30%_center]'
            ]}
          />
          {imageCaption && <figcaption class="mt-2 text-sm text-ink-soft">{imageCaption}</figcaption>}
        </figure>
      )}
    </div>
  </section>

  <section class={section}>
    <div class:list={[shell, "grid grid-cols-[minmax(0,1.3fr)_minmax(280px,.7fr)] gap-16 max-tablet:grid-cols-1 max-tablet:gap-12"]}>
      <div>
        {included.length > 0 && (
          <section aria-labelledby="included-heading">
            <p class="mb-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark">Service scope</p>
            <h2 id="included-heading" class="mb-3 text-[clamp(1.8rem,3vw,2.45rem)]">{includedHeading}</h2>
            <p class="mb-6 max-w-[680px] text-base">{includedIntro}</p>
            <ul class="m-0 list-none border-b border-line p-0" role="list">
              {included.map((item: string) => (
                <li class="grid grid-cols-[14px_1fr] items-start gap-3 border-t border-line py-4 text-base leading-[1.55]">
                  <span class="mt-2 size-2 rounded-full bg-teal" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {options.length > 0 && (
          <section class="mt-14" aria-labelledby="options-heading">
            <p class="mb-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark">Available extras</p>
            <h2 id="options-heading" class="mb-3 text-[clamp(1.8rem,3vw,2.45rem)]">{servicePageDefaults.optionsHeading}</h2>
            <p class="mb-6 max-w-[680px] text-base">{optionsIntro}</p>
            <ul class="m-0 list-none border-b border-line p-0" role="list">
              {options.map((opt: string) => (
                <li class="grid grid-cols-[42px_1fr] items-start gap-3 border-t border-line py-4 text-small font-[700]">
                  <span class="text-[1.05rem] font-black text-sea" aria-hidden="true">+</span>
                  <span>{opt}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <aside class="self-start border-y border-line bg-sand px-6 py-7 max-tablet:max-w-[720px] max-mobile:px-5" aria-label="Service details">
        {who && (
          <div>
            <p class="mb-2 text-eyebrow font-extrabold uppercase tracking-[.11em] text-sea-dark">Best fit</p>
            <h2 class="mb-3 text-[1.35rem]">{servicePageDefaults.whoHeading}</h2>
            <p class="text-[.98rem] leading-[1.62]">{who}</p>
          </div>
        )}

        {pricing && (
          <div class:list={[who && 'mt-8 border-t border-line pt-8']}>
            <p class="mb-2 text-eyebrow font-extrabold uppercase tracking-[.11em] text-sea-dark">Quote factors</p>
            <h2 class="mb-3 text-[1.35rem]">{servicePageDefaults.pricingHeading}</h2>
            <p class="text-[.98rem] leading-[1.62]">{pricing}</p>
            {pricingRows && <RentalPricing />}
            <div class="mt-5 border-b border-line">
              {pricingFactors.map((factor: string) => (
                <div class="border-t border-line py-2.5 text-label font-[750] text-ink">{factor}</div>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class:list={[section, "border-t border-line bg-sand"]}>
      <div class:list={[shell, "grid grid-cols-[.65fr_1.35fr] gap-14 max-tablet:grid-cols-1 max-tablet:gap-6"]}>
        <div>
          <p class="mb-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark">Questions</p>
          <h2>{servicePageDefaults.faqsHeading}</h2>
        </div>
        <div class="grid gap-3">
          {faqs.map((faq: { q: string, a: string }) => (
            <details class={details}>
              <summary class={summary}>{faq.q}</summary>
              <p class="mt-3">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTA quoteHref={quoteHref} />
</BaseLayout>
