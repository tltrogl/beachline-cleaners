---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from './CTA.astro';
import { site, servicePageDefaults } from '../data/content';

interface FAQ {
  q: string;
  a: string;
}

interface Props {
  title: string;
  eyebrow: string;
  intro: string;
  image?: string;
  imageAlt?: string;
  imageFocalPoint?: 'center' | 'right';
  included?: string[];
  who?: string;
  options?: string[];
  pricing?: string;
  faqs?: FAQ[];
}

const { 
  title, 
  eyebrow, 
  intro, 
  image, 
  imageAlt = servicePageDefaults.defaultImageAlt,
  imageFocalPoint = 'center',
  included = [], 
  who = '',
  options = [],
  pricing = '',
  faqs = [] 
} = Astro.props;
---
<BaseLayout title={`${title} | ${site.name}`} description={intro}>
  <section class="page-hero">
    <div class="container split">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="lede">{intro}</p>
        <div class="hero-actions service-hero-actions">
          <a class="btn btn-primary" href={servicePageDefaults.quoteHref}>{servicePageDefaults.quoteButtonText} <span aria-hidden="true">→</span></a>
          <a class="hero-phone" href={site.phoneHref}>{servicePageDefaults.callButtonPrefix}{site.phoneDisplay}</a>
        </div>
      </div>
      {image && (
        <div>
          <img
            src={image}
            alt={imageAlt}
            class:list={[
              'service-hero-img',
              imageFocalPoint === 'right' && 'service-hero-img-focus-right'
            ]}
          />
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      {included.length > 0 && (
        <div class="service-block">
          <h2>{servicePageDefaults.includedHeading}</h2>
          <p class="service-block-intro">{servicePageDefaults.includedIntro}</p>
          <ul class="checklist-grid" role="list">
            {included.map((item: string) => (
              <li class="checklist-item">
                <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {who && (
        <div class="service-block service-card-box">
          <h2>{servicePageDefaults.whoHeading}</h2>
          <p>{who}</p>
        </div>
      )}

      {options.length > 0 && (
        <div class="service-block">
          <h2>{servicePageDefaults.optionsHeading}</h2>
          <p class="service-block-intro">{servicePageDefaults.optionsIntro}</p>
          <ul class="options-grid" role="list">
            {options.map((opt: string) => (
              <li class="option-pill">
                <span class="plus-icon" aria-hidden="true">+</span>
                <span>{opt}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {pricing && (
        <div class="service-block service-card-box">
          <h2>{servicePageDefaults.pricingHeading}</h2>
          <p>{pricing}</p>
          <div class="pricing-factors">
            {servicePageDefaults.pricingFactors.map((factor: string) => (
              <span class="factor-tag">{factor}</span>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="section section-mist">
      <div class="container container-narrow">
        <h2 class="service-faq-heading">{servicePageDefaults.faqsHeading}</h2>
        <div class="faq">
          {faqs.map((faq: { q: string, a: string }) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTA />
</BaseLayout>

<style>
  .service-hero-actions {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }
  .hero-phone {
    font-weight: 750;
    font-size: .95rem;
  }
  .service-hero-img {
    object-position: center;
  }
  .service-hero-img-focus-right {
    object-position: 70% center;
  }
  .service-faq-heading {
    margin-bottom: 24px;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    letter-spacing: -.035em;
  }
  .service-block {
    margin-top: 48px;
  }
  .service-block:first-child {
    margin-top: 0;
  }
  .service-block h2 {
    font-size: clamp(1.7rem, 2.8vw, 2.2rem);
    letter-spacing: -.035em;
    margin-bottom: 10px;
  }
  .service-block-intro {
    font-size: 1rem;
    color: var(--ink-soft);
    margin-bottom: 18px;
  }
  .checklist-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 24px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .checklist-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink);
  }
  .check-icon {
    flex-shrink: 0;
    color: var(--sea);
    margin-top: 3px;
  }
  .service-card-box {
    background: #f8fafc;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 28px 30px;
  }
  .service-card-box p {
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .option-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: white;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-weight: 700;
    font-size: .95rem;
    color: var(--ink);
  }
  .plus-icon {
    color: var(--sea);
    font-weight: 900;
    font-size: 1.1rem;
  }
  .pricing-factors {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }
  .factor-tag {
    background: white;
    border: 1px solid var(--line);
    padding: 6px 12px;
    border-radius: 6px;
    font-size: .84rem;
    font-weight: 750;
    color: var(--sea-dark);
  }
  @media (max-width: 640px) {
    .checklist-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .service-card-box {
      padding: 22px 20px;
    }
  }
</style>
