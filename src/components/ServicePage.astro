---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from './CTA.astro';
import Button from './Button.astro';
import { shell, section, pageHero, pageTitle, eyebrow as eyebrowClass, lede, split, splitImage, details, summary, phone } from '../styles/ui';
import { site, servicePageDefaults } from '../data/content';

interface FAQ {
  q: string;
  a: string;
}

interface Props {
  title: string;
  eyebrow: string;
  intro: string;
  image?: string;
  imageAlt?: string;
  imageFocalPoint?: 'center' | 'left' | 'right';
  included?: string[];
  who?: string;
  options?: string[];
  pricing?: string;
  pricingFactors?: string[];
  faqs?: FAQ[];
}

const { 
  title, 
  eyebrow, 
  intro, 
  image, 
  imageAlt = servicePageDefaults.defaultImageAlt,
  imageFocalPoint = 'center',
  included = [], 
  who = '',
  options = [],
  pricing = '',
  pricingFactors = servicePageDefaults.pricingFactors,
  faqs = [] 
} = Astro.props;
---
<BaseLayout title={`${title} | ${site.name}`} description={intro}>
  <section class={pageHero}>
    <div class:list={[shell, split]}>
      <div>
        <p class={eyebrowClass}>{eyebrow}</p>
        <h1 class={pageTitle}>{title}</h1>
        <p class:list={[lede, "mt-[18px]"]}>{intro}</p>
        <div class="mt-6 flex flex-wrap items-center gap-control-gap">
          <Button href={servicePageDefaults.quoteHref}>{servicePageDefaults.quoteButtonText} <span aria-hidden="true">→</span></Button>
          <a class={phone} href={site.phoneHref}>{servicePageDefaults.callButtonPrefix}{site.phoneDisplay}</a>
        </div>
      </div>
      {image && (
        <div>
          <img
            src={image}
            alt={imageAlt}
            class:list={[
              splitImage,
              imageFocalPoint === 'right' && 'object-[70%_center]',
              imageFocalPoint === 'left' && 'object-[30%_center]'
            ]}
          />
        </div>
      )}
    </div>
  </section>

  <section class={section}>
    <div class:list={[shell, "max-w-[860px]"]}>
      {included.length > 0 && (
        <div class="mt-12 first:mt-0">
          <h2 class="mb-2.5 text-[clamp(1.7rem,2.8vw,2.2rem)]">{servicePageDefaults.includedHeading}</h2>
          <p class="mb-[18px] text-base">{servicePageDefaults.includedIntro}</p>
          <ul class="m-0 grid list-none grid-cols-2 gap-x-6 gap-y-[14px] p-0 max-[641px]:grid-cols-1 max-[641px]:gap-3" role="list">
            {included.map((item: string) => (
              <li class="flex items-start gap-3 text-base leading-[1.5]">
                <svg class="mt-[3px] shrink-0 text-sea" viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {who && (
        <div class="mt-12 rounded-panel border border-line bg-[#f8fafc] px-[30px] py-7 first:mt-0 max-[641px]:px-5 max-[641px]:py-[22px]">
          <h2 class="mb-2.5 text-[clamp(1.7rem,2.8vw,2.2rem)]">{servicePageDefaults.whoHeading}</h2>
          <p class="text-[1.02rem]">{who}</p>
        </div>
      )}

      {options.length > 0 && (
        <div class="mt-12 first:mt-0">
          <h2 class="mb-2.5 text-[clamp(1.7rem,2.8vw,2.2rem)]">{servicePageDefaults.optionsHeading}</h2>
          <p class="mb-[18px] text-base">{servicePageDefaults.optionsIntro}</p>
          <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-3 p-0" role="list">
            {options.map((opt: string) => (
              <li class="flex items-center gap-2.5 rounded-lg border border-line bg-white px-4 py-3 text-small font-bold">
                <span class="text-[1.1rem] font-black text-sea" aria-hidden="true">+</span>
                <span>{opt}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {pricing && (
        <div class="mt-12 rounded-panel border border-line bg-[#f8fafc] px-[30px] py-7 first:mt-0 max-[641px]:px-5 max-[641px]:py-[22px]">
          <h2 class="mb-2.5 text-[clamp(1.7rem,2.8vw,2.2rem)]">{servicePageDefaults.pricingHeading}</h2>
          <p class="text-[1.02rem]">{pricing}</p>
          <div class="mt-[18px] flex flex-wrap gap-2">
            {pricingFactors.map((factor: string) => (
              <span class="rounded-md border border-line bg-white px-3 py-1.5 text-[.84rem] font-[750] text-sea-dark">{factor}</span>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  {faqs.length > 0 && (
    <section class:list={[section, "bg-mist"]}>
      <div class:list={[shell, "max-w-[860px]"]}>
        <h2 class="mb-6">{servicePageDefaults.faqsHeading}</h2>
        <div class="grid gap-3">
          {faqs.map((faq: { q: string, a: string }) => (
            <details class={details}>
              <summary class={summary}>{faq.q}</summary>
              <p class="mt-3">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTA />
</BaseLayout>
