---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'light' | 'outline';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  size?: 'default' | 'navigation' | 'compact';
}
const { href, variant = 'primary', class: className, type = 'button', size = 'default', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const sizes = {
  default: 'min-h-[50px] px-[22px] text-[.94rem] font-extrabold',
  navigation: 'min-h-[50px] px-[22px] text-[.85rem] font-extrabold group-[.island-home]/site:mobile:max-wide:text-[.78rem] group-[.island-home]/site:max-mobile:text-[.95rem]',
  compact: 'min-h-[46px] px-[22px] text-[.92rem] font-[750]',
};
const variants = {
  primary: 'border-transparent bg-sea-dark text-white hover:bg-sea',
  secondary: 'border-line bg-white text-ink hover:border-[#12343b47]',
  light: 'border-transparent bg-white text-ink hover:bg-mist',
  outline: 'border-[1.5px] border-white/70 bg-transparent text-white hover:border-white hover:bg-white/15',
};
---
<Tag href={href} type={href ? undefined : type} {...rest} class:list={[
  'inline-flex items-center justify-center gap-[14px] rounded-lg border no-underline transition-[transform,background,border-color] duration-200 motion-safe:hover:-translate-y-0.5 disabled:cursor-wait disabled:opacity-70',
  variants[variant], sizes[size], className,
]}><slot /></Tag>
