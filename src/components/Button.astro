---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'light' | 'outline';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  size?: 'default' | 'navigation' | 'compact';
}
const { href, variant = 'primary', class: className, type = 'button', size = 'default', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const sizes = {
  default: 'min-h-[50px] px-control-x text-action font-extrabold',
  navigation: 'min-h-[50px] px-control-x text-nav font-extrabold group-[.island-home]/site:mobile:max-wide:text-nav-compact group-[.island-home]/site:max-mobile:text-small',
  compact: 'min-h-[46px] px-control-x text-compact-action font-[750]',
};
const variants = {
  primary: 'border-transparent bg-sea text-white hover:bg-sea-dark active:bg-sea-dark',
  secondary: 'border-line bg-white text-ink hover:border-sea/30 active:bg-line/30',
  light: 'border-transparent bg-white text-ink hover:bg-line/30 active:bg-white',
  outline: 'border-[1.5px] border-white/70 bg-transparent text-white hover:border-white hover:bg-white/15 active:bg-white/25',
};
---
<Tag href={href} type={href ? undefined : type} {...rest} class:list={[
  'inline-flex items-center justify-center gap-control-gap rounded-lg border no-underline transition-[transform,background,border-color] duration-200 motion-safe:not-disabled:hover:-translate-y-0.5 motion-safe:active:translate-y-0 disabled:cursor-wait disabled:opacity-70',
  variants[variant], sizes[size], className,
]}><slot /></Tag>
