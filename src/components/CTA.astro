---
import Button from './Button.astro';
import { shell, section } from '../styles/ui';
import { site, ctaDefaults } from '../data/content';

interface Props {
  title?: string;
  text?: string;
  quoteHref?: string;
}

const { 
  title = ctaDefaults.defaultTitle, 
  text = ctaDefaults.defaultText,
  quoteHref = ctaDefaults.quoteHref
} = Astro.props;
---
<section class={section}>
  <div class={shell}>
    <div class="grid grid-cols-[1fr_auto] items-center gap-[30px] rounded-2xl bg-sea p-12 text-white max-mobile:grid-cols-1 max-mobile:p-[34px]">
      <div>
        <h2 class="text-[clamp(2.2rem,4vw,3.6rem)] group-[.island-home]/site:text-[clamp(1.4rem,2vw,1.8rem)]">{title}</h2>
        <p class="mt-3 text-white/76">{text}</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <Button variant="light" href={quoteHref}>{ctaDefaults.quoteButtonText} <span aria-hidden="true">→</span></Button>
        <Button variant="outline" href={site.phoneHref}>{ctaDefaults.callButtonPrefix}{site.phoneDisplay}</Button>
      </div>
    </div>
  </div>
</section>
