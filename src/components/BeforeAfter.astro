---
import SiteImage from './SiteImage.astro';
import { shell } from '../styles/ui';
---
<section class="border-t border-line py-12" aria-labelledby="before-after-heading">
  <div class={shell}>
    <div class="mb-8">
      <h2 id="before-after-heading">See the Difference</h2>
      <p class="mt-[22px] text-[1.09rem]">Experience the Beachline Cleaners transformation.</p>
    </div>
    
    <div class="mt-8 flex flex-col gap-4">
      <div class="grid grid-cols-2 gap-4">
        <div class="relative">
          <span class="absolute top-4 left-4 rounded bg-overlay/70 px-3 py-1 text-sm font-bold text-paper">Before</span>
          <SiteImage src="/images/before_clean.jpg" alt="Before cleaning" class="h-auto min-h-[200px] w-full rounded-lg bg-neutral-soft object-cover" loading="lazy" />
        </div>
        <div class="relative">
          <span class="absolute top-4 left-4 rounded bg-overlay/70 px-3 py-1 text-sm font-bold text-paper">After</span>
          <SiteImage src="/images/after_clean.jpg" alt="After cleaning" class="h-auto min-h-[200px] w-full rounded-lg bg-neutral-soft object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>
