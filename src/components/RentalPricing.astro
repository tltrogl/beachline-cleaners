---
import { pricingContent, servicesDetail } from '../data/content';
---
<div class="mt-6">
  <h3 class="mb-3 text-[1.15rem]">{pricingContent.rentalHeading}</h3>
  <table class="w-full border-collapse text-left text-small">
    <caption class="sr-only">{pricingContent.rentalHeading}</caption>
    <thead>
      <tr class="border-y border-line">
        <th scope="col" class="py-3 pr-4 font-bold">{pricingContent.propertyColumn}</th>
        <th scope="col" class="py-3 font-bold">{pricingContent.priceColumn}</th>
      </tr>
    </thead>
    <tbody>
      {servicesDetail.vacationRental.pricingRows?.map((row) => (
        <tr class="border-b border-line">
          <th scope="row" class="py-3 pr-4 font-normal">{row.property}</th>
          <td class="py-3 font-bold text-sea-dark">{row.price}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="mt-4 text-small">{pricingContent.rentalIncluded}</p>
  <p class="mt-3 text-small">{pricingContent.note}</p>
</div>
