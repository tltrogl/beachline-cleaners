---
interface Props {
  name: 'arrow-right' | 'phone' | 'check-circle';
  class?: string;
}
const { name, class: className = 'size-5' } = Astro.props;
---
<svg class:list={['shrink-0', className]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow-right' && <path d="M4 12h16m-6-6 6 6-6 6" />}
  {name === 'phone' && <path d="M6.5 3h3l1.5 5-2.5 2a15 15 0 0 0 5.5 5.5l2-2.5 5 1.5v3a3 3 0 0 1-3 3C10.5 20.5 3.5 13.5 3.5 6a3 3 0 0 1 3-3Z" />}
  {name === 'check-circle' && <><circle cx="12" cy="12" r="9" /><path d="m8 12 3 3 5-6" /></>}
</svg>
