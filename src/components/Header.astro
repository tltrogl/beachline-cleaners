---
import { site, navigationContent, withBase } from '../data/content';
import { shell, details } from '../styles/ui';
import Button from './Button.astro';
interface Props { quoteHref?: string; }
const { quoteHref = navigationContent.quoteHref } = Astro.props;
const navLink = 'text-nav font-bold no-underline hover:text-sea group-[.island-home]/site:mobile:max-wide:text-nav-compact group-[.island-home]/site:max-mobile:text-small';
const brand = 'inline-flex items-center gap-3 whitespace-nowrap font-black tracking-[-.03em] no-underline group-[.island-home]/site:mobile:max-wide:text-[.88rem] group-[.island-home]/site:max-mobile:text-label';
---
<header class="header sticky top-0 z-50 border-b-4 border-cyan bg-white">
  <div class:list={[shell, 'nav relative flex min-h-[78px] items-center gap-card-gap max-mobile:min-h-[70px] max-mobile:gap-3 group-[.island-home]/site:mobile:max-wide:gap-[15px]']}>
    <a class={brand} href={withBase('/')} aria-label={navigationContent.brandHomeAriaLabel}>
      <span class="brand-mark relative size-[38px] shrink-0 overflow-hidden rounded-[50%_50%_46%_54%] bg-sea group-[.island-home]/site:max-mobile:size-8" aria-hidden="true"></span>
      <span>{site.name}</span>
    </a>
    <button class="mobile-toggle ml-auto hidden rounded-full border border-line bg-white px-[14px] py-2.5 font-extrabold max-mobile:inline-flex" type="button" aria-expanded="false" aria-controls="nav-links">{navigationContent.menuButton}</button>
    <nav class="nav-links ml-auto flex items-center gap-5 max-mobile:absolute max-mobile:inset-x-0 max-mobile:top-[70px] max-mobile:hidden max-mobile:max-h-[calc(100dvh-155px)] max-mobile:flex-col max-mobile:items-stretch max-mobile:overflow-y-auto max-mobile:rounded-2xl max-mobile:border max-mobile:border-line max-mobile:bg-white max-mobile:p-[18px] max-mobile:shadow-site max-mobile:[&.open]:flex group-[.island-home]/site:mobile:max-wide:gap-control-gap" id="nav-links" aria-label={navigationContent.navAriaLabel}>
      <details class:list={[details, 'nav-services group/services relative max-mobile:w-full group-[.island-home]/site:border-0 group-[.island-home]/site:bg-transparent group-[.island-home]/site:p-0']}>
        <summary class:list={[navLink, 'list-none cursor-pointer max-mobile:py-2']}>{navigationContent.servicesDropdownLabel}</summary>
        <div class="nav-services-menu absolute top-[calc(100%+14px)] -left-[18px] hidden min-w-[220px] rounded-panel border border-line bg-white p-2.5 shadow-site group-open/services:grid max-mobile:static max-mobile:border-0 max-mobile:pt-1.5 max-mobile:pl-3 max-mobile:shadow-none">
          {navigationContent.serviceLinks.map((item) => <a class:list={[navLink, 'rounded-[9px] px-3 py-2.5 hover:bg-line/30']} href={item.href}>{item.title}</a>)}
        </div>
      </details>
      {navigationContent.links.map((item) => <a class={navLink} href={item.href}>{item.title}</a>)}
      <a class:list={[navLink, 'nav-phone whitespace-nowrap max-[1021px]:hidden max-mobile:block group-[.island-home]/site:mobile:max-wide:hidden']} href={site.phoneHref}>{navigationContent.callPrefix}{site.phoneDisplay}</a>
      <Button size="navigation" class="max-mobile:w-full group-[.island-home]/site:mobile:max-wide:px-3" href={quoteHref}>{navigationContent.quoteButton}</Button>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector('.mobile-toggle');
  const nav = document.querySelector('#nav-links');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const services = document.querySelector<HTMLDetailsElement>('.nav-services');
    if (services?.open) {
      services.open = false;
      services.querySelector('summary')?.focus();
    } else if (nav?.classList.contains('open')) {
      nav.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
      if (btn instanceof HTMLElement) btn.focus();
    }
  });
</script>
