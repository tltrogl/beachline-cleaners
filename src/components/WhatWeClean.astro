---
import Icon from './Icon.astro';
import { withBase } from '../data/content';
import { shell, homeEyebrow, outlineLink } from '../styles/ui';

const areas = [
  { title: 'Kitchen', text: 'Counters, appliance exteriors, sinks, cabinet fronts, and floors.' },
  { title: 'Bathrooms', text: 'Toilets, showers, tubs, mirrors, counters, fixtures, and floors.' },
  { title: 'Bedrooms', text: 'Reachable surfaces, mirrors, floors, and a basic room reset.' },
  { title: 'Living areas', text: 'Reachable surfaces, furniture-area dusting, vacuuming, and mopping.' },
  { title: 'Floors & finishing', text: 'Vacuuming carpets, mopping hard floors, and final room-by-room checks.' },
];
---
<section class="border-y border-line bg-sand py-[76px] max-mobile:py-14" aria-labelledby="what-we-clean-heading">
  <div class:list={[shell, "grid grid-cols-[.7fr_1.3fr] gap-16 max-tablet:grid-cols-1 max-tablet:gap-8"]}>
    <div>
      <p class:list={[homeEyebrow, 'flex items-center gap-3']}><span class="h-px w-10 bg-sea" aria-hidden="true"></span>Room by room</p>
      <h2 id="what-we-clean-heading">What we clean.</h2>
      <p class="mt-5 max-w-[430px] text-[1.04rem] leading-[1.68]">Routine home cleaning covers the core areas below. We confirm the checklist and any extras before booking.</p>
      <p class="mt-6 max-w-[440px] text-small leading-[1.6] text-ink-soft">Deep-clean detail work and add-ons are scoped separately, so the quote matches the work you actually want done.</p>
      <a class:list={[outlineLink, 'mt-6']} href={withBase('/residential-cleaning')}>View the full cleaning checklist <Icon name="arrow-right" class="size-[18px]" /></a>
    </div>

    <div class="border-b border-line">
      {areas.map((area) => (
        <div class="grid grid-cols-[14px_150px_1fr] items-start gap-5 border-t border-line py-5 max-mobile:grid-cols-[14px_1fr] max-mobile:gap-x-3 max-mobile:gap-y-1">
          <span class="mt-2 size-2 rounded-full bg-teal" aria-hidden="true"></span>
          <h3 class="text-[1.05rem] max-mobile:col-start-2">{area.title}</h3>
          <p class="text-small leading-[1.55] max-mobile:col-start-2">{area.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
