---
// WhatWeClean.astro
---
<section class="what-we-clean-section outline-section outline-tint" aria-labelledby="what-we-clean-heading">
  <div class="container">
    <div class="section-heading-group">
      <h2 id="what-we-clean-heading">What We Clean</h2>
      <p class="hero-description">A comprehensive clean for every room in your home.</p>
    </div>
    
    <div class="what-we-clean-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; margin-top: 2rem;">
      <div class="clean-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="32" height="32" aria-hidden="true" style="margin-bottom: 1rem;">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <h3>Kitchen</h3>
        <p>Counters, appliances, sinks, and cabinet fronts.</p>
      </div>
      <div class="clean-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="32" height="32" aria-hidden="true" style="margin-bottom: 1rem;">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <h3>Bathrooms</h3>
        <p>Toilets, showers, tubs, mirrors, and fixtures.</p>
      </div>
      <div class="clean-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="32" height="32" aria-hidden="true" style="margin-bottom: 1rem;">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <h3>Bedrooms</h3>
        <p>Dusting, making beds, and general tidying.</p>
      </div>
      <div class="clean-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="32" height="32" aria-hidden="true" style="margin-bottom: 1rem;">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <h3>Floors</h3>
        <p>Vacuuming carpets and mopping hard floors.</p>
      </div>
      <div class="clean-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="32" height="32" aria-hidden="true" style="margin-bottom: 1rem;">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <h3>Dusting</h3>
        <p>Surfaces, baseboards, and window sills.</p>
      </div>
    </div>
  </div>
</section>
