---
import Icon from './Icon.astro';
import { withBase, homeContent } from '../data/content';
import { shell, homeEyebrow, outlineLink } from '../styles/ui';

const content = homeContent.standardCleanSection;
---
<section class="border-y border-line bg-seafoam py-[76px] max-mobile:py-14" aria-labelledby="what-we-clean-heading">
  <div class:list={[shell, "grid grid-cols-[.7fr_1.3fr] gap-16 max-tablet:grid-cols-1 max-tablet:gap-8"]}>
    <div>
      <p class:list={[homeEyebrow, 'flex items-center gap-3']}><span class="h-px w-10 bg-sea" aria-hidden="true"></span>Room by room</p>
      <h2 id="what-we-clean-heading">{content.heading}</h2>
      <p class="mt-5 max-w-[430px] text-[1.04rem] leading-[1.68]">{content.intro}</p>
      <p class="mt-6 max-w-[440px] text-small leading-[1.6] text-ink-soft">{content.extrasHint}</p>
      <a class:list={[outlineLink, 'mt-6']} href={withBase('/residential-cleaning')}>Explore home cleaning tasks <Icon name="arrow-right" class="size-[18px]" /></a>
    </div>

    <div class="border-b border-line">
      {content.areas.map((area) => (
        <div class="grid grid-cols-[14px_150px_1fr] items-start gap-5 border-t border-line py-5 max-mobile:grid-cols-[14px_1fr] max-mobile:gap-x-3 max-mobile:gap-y-1">
          <span class="mt-2 size-2 rounded-full bg-teal" aria-hidden="true"></span>
          <h3 class="text-[1.05rem] max-mobile:col-start-2">{area.title}</h3>
          <p class="text-small leading-[1.55] max-mobile:col-start-2">{area.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
