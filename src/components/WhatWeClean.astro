---
import Icon from './Icon.astro';
import { shell } from '../styles/ui';
---
<section class="border-t border-line bg-paper py-12" aria-labelledby="what-we-clean-heading">
  <div class={shell}>
    <div class="mb-8">
      <h2 id="what-we-clean-heading">What We Clean</h2>
      <p class="mt-[22px] text-[1.09rem] leading-[1.65] max-mobile:mt-[17px] max-mobile:text-base">A comprehensive clean for every room in your home.</p>
    </div>
    
    <div class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-5 max-mobile:grid-cols-2">
      <div >
        <Icon name="check-circle" class="mb-4 size-8 text-sea" />
        <h3>Kitchen</h3>
        <p class="mt-2.5 text-small">Counters, appliances, sinks, and cabinet fronts.</p>
      </div>
      <div >
        <Icon name="check-circle" class="mb-4 size-8 text-sea" />
        <h3>Bathrooms</h3>
        <p class="mt-2.5 text-small">Toilets, showers, tubs, mirrors, and fixtures.</p>
      </div>
      <div >
        <Icon name="check-circle" class="mb-4 size-8 text-sea" />
        <h3>Bedrooms</h3>
        <p class="mt-2.5 text-small">Dusting, making beds, and general tidying.</p>
      </div>
      <div >
        <Icon name="check-circle" class="mb-4 size-8 text-sea" />
        <h3>Floors</h3>
        <p class="mt-2.5 text-small">Vacuuming carpets and mopping hard floors.</p>
      </div>
      <div >
        <Icon name="check-circle" class="mb-4 size-8 text-sea" />
        <h3>Dusting</h3>
        <p class="mt-2.5 text-small">Surfaces, baseboards, and window sills.</p>
      </div>
    </div>
  </div>
</section>
