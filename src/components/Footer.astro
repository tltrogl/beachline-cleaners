---
import { site, footerContent, withBase } from '../data/content';
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href={withBase('/')}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span>{site.name}</span>
        </a>
        <p class="footer-summary">{footerContent.summary}</p>
        <div class="footer-contact">
          <a href={site.phoneHref}>{site.phoneDisplay}</a>
        </div>
      </div>
      <div>
        <strong>{footerContent.servicesHeading}</strong>
        <div class="footer-links">
          {footerContent.serviceLinks.map((link) => (
            <a href={link.href}>{link.title}</a>
          ))}
        </div>
      </div>
      <div>
        <strong>{footerContent.companyHeading}</strong>
        <div class="footer-links">
          {footerContent.companyLinks.map((link) => (
            <a href={link.href}>{link.title}</a>
          ))}
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      © {new Date().getFullYear()} {site.name} {footerContent.copyrightSuffix}
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--ink);
  }
  .footer p, .footer a {
    color: var(--mist);
  }
</style>
