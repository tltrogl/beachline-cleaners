---
import { shell } from '../styles/ui';
import { site, footerContent, withBase } from '../data/content';

interface Props {
  quoteHref?: string;
}

const companyLinks = footerContent.companyLinks.filter(
  (link) => link.href !== withBase('/quote')
);
---

<footer class="footer bg-footer text-footer-text group-[.island-home]/site:bg-footer">
  <div class="h-[3px] bg-cyan" aria-hidden="true"></div>

  <div class:list={[shell, 'py-7 max-mobile:py-6']}>
    <div class="grid grid-cols-[1.55fr_.75fr_.7fr] gap-x-12 gap-y-6 max-tablet:grid-cols-[1.3fr_.85fr_.85fr] max-tablet:gap-x-8 max-mobile:grid-cols-2 max-mobile:gap-x-6 max-mobile:gap-y-5">

      <div class="max-w-[430px] max-mobile:col-span-2">
        <a
          class="inline-flex items-center gap-2.5 no-underline"
          href={withBase('/')}
          aria-label={`${site.name} home`}
        >
          <span
            class="brand-mark relative size-9 shrink-0 overflow-hidden rounded-[50%_50%_46%_54%] bg-sea-dark"
            aria-hidden="true"
          ></span>

          <span class="grid leading-none">
            <span class="text-[1.12rem] font-black tracking-[-.025em] text-paper">
              {site.name}
            </span>

            <span class="mt-1 text-[.61rem] font-extrabold uppercase tracking-[.15em] text-paper/65">
              {site.descriptor}
            </span>
          </span>
        </a>

        <p class="mt-3 max-w-[390px] text-[.9rem] leading-[1.5] text-paper/70">
          Local cleaning across Brevard County.
        </p>

        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[.88rem] font-[750]">
          <a
            class="text-paper underline decoration-paper/35 underline-offset-4 hover:decoration-cyan"
            href={site.phoneHref}
          >
            {site.phoneDisplay}
          </a>

          <a
            class="text-paper underline decoration-paper/35 underline-offset-4 hover:decoration-cyan"
            href={`mailto:${site.email}`}
          >
            {site.email}
          </a>
        </div>
      </div>

      <nav aria-label="Footer services">
        <p class="text-[.7rem] font-extrabold uppercase tracking-[.14em] text-cyan">
          {footerContent.servicesHeading}
        </p>

        <div class="mt-1.5 grid text-paper/78">
          {footerContent.serviceLinks.map((link) => (
            <a
              class="flex min-h-7 w-fit items-center text-[.88rem] no-underline transition-colors hover:text-paper"
              href={link.href}
            >
              {link.title}
            </a>
          ))}
        </div>
      </nav>

      <nav aria-label="Footer company links">
        <p class="text-[.7rem] font-extrabold uppercase tracking-[.14em] text-cyan">
          {footerContent.companyHeading}
        </p>

        <div class="mt-1.5 grid text-paper/78">
          {companyLinks.map((link) => (
            <a
              class="flex min-h-7 w-fit items-center text-[.88rem] no-underline transition-colors hover:text-paper"
              href={link.href}
            >
              {link.title}
            </a>
          ))}
        </div>
      </nav>
    </div>

    <div class="mt-5 flex items-center justify-between gap-5 border-t border-paper/14 pt-3.5 text-[.76rem] text-paper/72 max-mobile:flex-col max-mobile:items-start max-mobile:gap-1.5">
      <a
        class="font-[750] text-cyan no-underline hover:text-paper"
        href={withBase('/service-area')}
      >
        Serving Brevard County
      </a>

      <p class="text-paper/72">
        © {new Date().getFullYear()} {site.name}. {footerContent.copyrightSuffix}
      </p>
    </div>
  </div>
</footer>
