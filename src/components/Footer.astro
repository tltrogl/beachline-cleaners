---
import { shell } from '../styles/ui';
import { site, footerContent, withBase } from '../data/content';
interface Props { quoteHref?: string; }
const { quoteHref = withBase('/quote') } = Astro.props;
---
<footer class="footer bg-footer pt-[42px] pb-6 text-white group-[.island-home]/site:bg-footer max-mobile:pb-[calc(76px+env(safe-area-inset-bottom))] group-[.no-mobile-bar]/site:max-mobile:pb-[max(24px,env(safe-area-inset-bottom))]">
  <div class={shell}>
    <div class="grid grid-cols-[1.3fr_.7fr_.7fr] gap-[45px] max-tablet:grid-cols-2 max-mobile:grid-cols-2 max-mobile:gap-x-5 max-mobile:gap-y-7">
      <div class="max-mobile:col-span-2">
        <a class="inline-flex items-center gap-3 whitespace-nowrap font-black tracking-[-.03em] text-mist no-underline group-[.island-home]/site:text-footer-text" href={withBase('/')}>
          <span class="brand-mark relative size-[38px] shrink-0 overflow-hidden rounded-[50%_50%_46%_54%] bg-sea-dark group-[.island-home]/site:max-mobile:size-8" aria-hidden="true"></span>
          <span class="grid leading-none">
            <span>{site.name}</span>
            <span class="mt-1.5 text-[.64rem] font-extrabold uppercase tracking-[.13em] text-cyan">{site.descriptor}</span>
          </span>
        </a>
        <p class="mt-[18px] max-w-[430px] text-mist group-[.island-home]/site:text-footer-text">{footerContent.summary}</p>
        <div class="mt-[18px] flex gap-4 font-extrabold text-mist group-[.island-home]/site:text-footer-text">
          <a class="no-underline" href={site.phoneHref}>{site.phoneDisplay}</a>
        </div>
      </div>
      <div>
        <strong>{footerContent.servicesHeading}</strong>
        <div class="mt-4 grid gap-1 text-mist group-[.island-home]/site:text-footer-text">
          {footerContent.serviceLinks.map((link) => (
            <a class="w-fit min-h-11 flex items-center py-1 no-underline hover:underline hover:underline-offset-4" href={link.href}>{link.title}</a>
          ))}
        </div>
      </div>
      <div>
        <strong>{footerContent.companyHeading}</strong>
        <div class="mt-4 grid gap-1 text-mist group-[.island-home]/site:text-footer-text">
          {footerContent.companyLinks.map((link) => (
            <a class="w-fit min-h-11 flex items-center py-1 no-underline hover:underline hover:underline-offset-4" href={link.href === withBase('/quote') ? quoteHref : link.href}>{link.title}</a>
          ))}
        </div>
      </div>
    </div>
    <div class="mt-[26px] border-t border-white/20 pt-6 text-[.84rem] text-white/75">
      © {new Date().getFullYear()} {site.name} {footerContent.copyrightSuffix}
    </div>
  </div>
</footer>
