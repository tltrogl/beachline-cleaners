---
import SiteImage from '../components/SiteImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { shell, homeEyebrow, phone } from '../styles/ui';
import { site, servicesDetail, servicePageDefaults } from '../data/content';

const content = servicesDetail.commercial;
---
<BaseLayout title={`${content.metaTitle} | ${site.name}`} description={content.metaDescription} quoteHref={content.quoteHref}>
  <section class="border-b border-line bg-white pt-12 pb-14 max-mobile:pt-7 max-mobile:pb-9" aria-labelledby="commercial-hero-title" slot="hero">
    <div class:list={[shell, "grid grid-cols-[1.08fr_.92fr] items-center gap-16 max-tablet:gap-9 max-mobile:grid-cols-1 max-mobile:gap-7"]}>
      <div class="relative order-1 pb-3 pl-3 max-mobile:order-2">
        <span class="absolute bottom-0 left-0 h-20 w-28 rounded-panel bg-[#C94F68]" aria-hidden="true"></span>
        <figure class="relative m-0 overflow-hidden rounded-panel bg-mist shadow-[0_20px_58px_rgba(28,65,91,.09)]">
        <SiteImage src={content.image} alt={content.imageAlt} width="1280" height="800" class="aspect-[1.2] w-full object-cover object-left max-mobile:aspect-[1.55]" fetchpriority="high" />
        </figure>
      </div>
      <div class="order-2 max-mobile:order-1">
        <p class:list={[homeEyebrow, 'flex items-center gap-3']}><span class="h-px w-10 shrink-0 bg-teal" aria-hidden="true"></span>Workspaces</p>
        <h1 id="commercial-hero-title" class="max-w-[700px] text-[clamp(2.9rem,4.8vw,4.35rem)] leading-[1.03] tracking-[-.04em] max-mobile:text-[2.75rem]">{content.title}</h1>
        <p class="mt-6 max-w-[610px] text-lede leading-[1.62] max-mobile:mt-4">{content.intro}</p>
        <div class="mt-7 flex flex-wrap items-center gap-control-gap">
          <Button href={content.quoteHref}>{servicePageDefaults.quoteButtonText} <Icon name="arrow-right" class="size-[18px]" /></Button>
          <a class={phone} href={site.phoneHref}>{servicePageDefaults.callButtonPrefix}{site.phoneDisplay}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-line bg-mist/55 py-[76px] max-mobile:py-14" aria-labelledby="commercial-included-heading">
    <div class={shell}>
      <div class="flex items-end justify-between gap-12 border-b border-line pb-7 max-tablet:items-start max-mobile:flex-col max-mobile:gap-3">
        <div>
          <p class:list={[homeEyebrow, 'flex items-center gap-3']}><span class="h-1 w-10 rounded-full bg-[#C94F68]" aria-hidden="true"></span>Routine checklist</p>
          <h2 id="commercial-included-heading" class="max-w-[580px]">Cleaning for the areas people use every day.</h2>
        </div>
        <p class="max-w-[450px] text-[1rem] leading-[1.65]">We’ll agree on the checklist for your space before service starts.</p>
      </div>

      <ul class="m-0 grid list-none grid-cols-3 p-0 max-tablet:grid-cols-2 max-mobile:grid-cols-1" role="list">
        {content.included.map((item, index) => (
          <li class:list={[
            'min-h-[160px] border-b border-line py-6 text-[.98rem] leading-[1.62]',
            index % 3 !== 0 ? 'border-l pl-7 max-tablet:border-l-0 max-tablet:pl-0' : 'pr-7 max-tablet:pr-0',
            index % 3 === 1 ? 'px-7 max-tablet:px-0' : '',
            index % 3 === 2 ? 'pl-7 max-tablet:pl-0' : '',
            index % 2 === 1 ? 'max-tablet:border-l max-tablet:pl-7 max-mobile:border-l-0 max-mobile:pl-0' : 'max-tablet:pr-7 max-mobile:pr-0'
          ]}>
            <span class="mb-4 flex size-8 items-center justify-center rounded-full bg-[#C94F68] text-white shadow-[0_1px_0_rgba(30,41,59,.08)]" aria-hidden="true"><Icon name="check-circle" class="size-[18px]" /></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-ocean py-[70px] text-white max-mobile:py-14" aria-labelledby="commercial-price-heading">
    <div class:list={[shell, "grid grid-cols-[.72fr_1.28fr] gap-16 max-tablet:grid-cols-1 max-tablet:gap-10"]}>
      <div>
        <p class="mb-2 text-eyebrow font-extrabold uppercase tracking-[.12em] text-cyan">Pricing</p>
        <h2 id="commercial-price-heading" class="text-[clamp(2.5rem,4.4vw,3.9rem)] tracking-[-.045em] text-white">{content.priceLabel}</h2>
        <p class="mt-5 max-w-[470px] text-[1.02rem] leading-[1.68] text-white/72">{content.pricing}</p>
      </div>

      <div>
        <p class="mb-2 text-eyebrow font-extrabold uppercase tracking-[.12em] text-cyan">Service options</p>
        <h2 class="text-[clamp(1.85rem,3vw,2.45rem)] text-white">Build the schedule around the space.</h2>
        <ul class="mt-6 m-0 grid list-none grid-cols-2 border-t border-white/20 p-0 max-mobile:grid-cols-1" role="list">
          {content.options.map((option, index) => (
            <li class:list={[
              'grid grid-cols-[28px_1fr] border-b border-white/20 py-[18px] text-white/80',
              index % 2 === 0 ? 'pr-7 max-mobile:pr-0' : 'border-l border-white/20 pl-7 max-mobile:border-l-0 max-mobile:pl-0'
            ]}>
              <span class="font-black text-cyan" aria-hidden="true">+</span>
              <span class="font-[700]">{option}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CTA quoteHref={content.quoteHref} />
</BaseLayout>
