---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { shell, details, summary, phone } from '../styles/ui';
import { servicePageDefaults, servicesDetail, site } from '../data/content';

const content = servicesDetail.commercial;
---
<BaseLayout title={`${content.metaTitle} | ${site.name}`} description={content.metaDescription} quoteHref={content.quoteHref}>
  <section class="border-b border-line bg-white pt-12 pb-14 max-mobile:pt-7 max-mobile:pb-9" aria-labelledby="commercial-hero-title" slot="hero">
    <div class:list={[shell, "grid grid-cols-[.9fr_1.1fr] items-center gap-14 max-tablet:gap-8 max-mobile:grid-cols-1 max-mobile:gap-7"]}>
      <div>
        <p class="mb-3 flex items-center gap-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark">
          <span class="h-px w-10 shrink-0 bg-sea" aria-hidden="true"></span>{content.eyebrow}
        </p>
        <h1 id="commercial-hero-title" class="max-w-[720px] text-[clamp(2.7rem,4.5vw,4rem)] leading-[1.08] tracking-[-.03em] max-mobile:text-[2.65rem]">{content.title}</h1>
        <p class="mt-6 max-w-[620px] text-lede leading-[1.6] max-mobile:mt-4">{content.intro}</p>
        <p class="mt-5 text-[1.2rem] font-bold text-sea-dark">{content.priceLabel}</p>
        <div class="mt-7 flex flex-wrap items-center gap-control-gap">
          <Button href={content.quoteHref}>{servicePageDefaults.quoteButtonText} <Icon name="arrow-right" class="size-[18px]" /></Button>
          <a class={phone} href={site.phoneHref}>{servicePageDefaults.callButtonPrefix}{site.phoneDisplay}</a>
        </div>
      </div>

      <figure class="m-0 overflow-hidden rounded-panel bg-mist shadow-[0_18px_55px_rgba(28,65,91,.09)]">
        <img src={content.image} alt={content.imageAlt} width="1280" height="800" class="aspect-[1.2] w-full object-cover object-left max-mobile:aspect-[1.55]" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="py-[74px] max-mobile:py-14" aria-labelledby="facility-heading">
    <div class={shell}>
      <div class="grid grid-cols-[.72fr_1.28fr] gap-14 max-tablet:grid-cols-1 max-tablet:gap-6">
        <div>
          <p class="mb-3 flex items-center gap-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark"><span class="h-px w-10 bg-sea" aria-hidden="true"></span>Start with the facility</p>
          <h2 id="facility-heading" class="max-w-[500px]">Build the cleaning plan around how the space is actually used.</h2>
        </div>
        <p class="max-w-[760px] text-[1.08rem] leading-[1.72]">{content.who}</p>
      </div>

      <div class="mt-10 grid grid-cols-3 border-y border-line max-tablet:grid-cols-1 max-tablet:divide-y max-tablet:divide-line">
        <article class="py-7 pr-9 max-tablet:pr-0">
          <p class="mb-2 text-eyebrow font-extrabold uppercase tracking-[.11em] text-teal">Space</p>
          <h3>Facility type and high-use areas</h3>
          <p class="mt-3 text-[1rem] leading-[1.65]">Tell us whether it’s a small office, professional suite, retail space, or another light-commercial workplace and which areas see the most traffic.</p>
        </article>
        <article class="border-l border-line px-9 py-7 max-tablet:border-l-0 max-tablet:px-0">
          <p class="mb-2 text-eyebrow font-extrabold uppercase tracking-[.11em] text-teal">Schedule</p>
          <h3>One-time or recurring</h3>
          <p class="mt-3 text-[1rem] leading-[1.65]">Choose one-time, weekly, biweekly, or a custom recurring schedule. After-hours or weekend visits can be arranged when availability allows.</p>
        </article>
        <article class="border-l border-line py-7 pl-9 max-tablet:border-l-0 max-tablet:pl-0">
          <p class="mb-2 text-eyebrow font-extrabold uppercase tracking-[.11em] text-teal">Access</p>
          <h3>Work around the building</h3>
          <p class="mt-3 text-[1rem] leading-[1.65]">Include access requirements, timing restrictions, and any areas that need special handling when you request the quote.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-mist py-[74px] max-mobile:py-14" aria-labelledby="commercial-scope-heading">
    <div class:list={[shell, "grid grid-cols-[.72fr_1.28fr] gap-16 max-tablet:grid-cols-1 max-tablet:gap-8"]}>
      <div>
        <p class="mb-3 flex items-center gap-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark"><span class="h-px w-10 bg-sea" aria-hidden="true"></span>Cleaning checklist</p>
        <h2 id="commercial-scope-heading">{content.includedHeading ?? 'What routine commercial cleaning can include'}</h2>
        <p class="mt-5 max-w-[470px] text-[1.04rem] leading-[1.68]">{content.includedIntro ?? 'We’ll agree on the checklist for the facility before service starts.'}</p>
      </div>
      <ul class="m-0 list-none border-y border-line bg-white px-7 max-mobile:px-5" role="list">
        {content.included.map((item, index) => (
          <li class="border-b border-line py-[17px] last:border-b-0">
            <p class:list={["text-[1rem] leading-[1.6]", index === 0 && "font-[750] text-ink"]}>{item}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-y border-line py-10 max-mobile:py-8" aria-labelledby="commercial-plan-heading">
    <div class={shell}>
      <h2 id="commercial-plan-heading" class="text-[1.65rem]">Adjust the service to your workplace.</h2>
      <p class="mt-3 max-w-[760px]">{content.optionsIntro}</p>
      <ul class="mt-5 grid list-disc grid-cols-2 gap-x-10 gap-y-3 pl-5 max-mobile:grid-cols-1" role="list">
        {content.options.map((option) => <li class="pl-1">{option}</li>)}
      </ul>
    </div>
  </section>

  <section class="border-y border-line py-[72px] max-mobile:py-10" aria-labelledby="commercial-price-heading">
    <div class:list={[shell, "grid grid-cols-[.78fr_1.22fr] gap-16 max-tablet:grid-cols-1 max-tablet:gap-8"]}>
      <div>
        <p class="mb-3 flex items-center gap-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark"><span class="h-px w-10 bg-sea" aria-hidden="true"></span>Custom pricing</p>
        <h2 id="commercial-price-heading">Pricing for your space and schedule.</h2>
        <p class="mt-5 max-w-[500px] text-[1.04rem] leading-[1.68]">{content.pricing}</p>
      </div>
      <ul class="m-0 mt-5 grid list-none grid-cols-2 gap-x-5 border-t border-line p-0 self-start" role="list">
          {content.pricingFactors.map((factor) => (
            <li class="border-b border-line py-4 text-[.96rem] font-bold text-ink">{factor}</li>
          ))}
        </ul>
    </div>
  </section>

  <section class="py-[72px] max-mobile:py-10" aria-labelledby="commercial-faq-heading">
    <div class:list={[shell, "grid grid-cols-[.62fr_1.38fr] gap-14 max-tablet:grid-cols-1 max-tablet:gap-7"]}>
      <div>
        <p class="mb-3 flex items-center gap-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark"><span class="h-px w-10 bg-sea" aria-hidden="true"></span>Business questions</p>
        <h2 id="commercial-faq-heading">Before service starts.</h2>
      </div>
      <div>
        {content.faqs.map((item) => (
          <details class={details}>
            <summary class={summary}>{item.q}</summary>
            <p class="pb-5 pr-8 text-[1rem] leading-[1.65]">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTA quoteHref={content.quoteHref} />
</BaseLayout>
