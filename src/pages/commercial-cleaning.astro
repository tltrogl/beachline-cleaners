---
import SiteImage from '../components/SiteImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { shell, homeEyebrow, phone, commercialUi, commercialChecklistItemClass } from '../styles/ui';
import { site, servicesDetail, servicePageDefaults } from '../data/content';

const content = servicesDetail.commercial;
---
<BaseLayout title={`${content.metaTitle} | ${site.name}`} description={content.metaDescription} quoteHref={content.quoteHref}>
  <section class={commercialUi.heroSection} aria-labelledby="commercial-hero-title" slot="hero">
    <div class:list={[shell, commercialUi.heroGrid]}>
      <div class={commercialUi.heroMedia}>
        <span class={commercialUi.heroAccent} aria-hidden="true"></span>
        <figure class={commercialUi.heroFigure}>
          <SiteImage src={content.image} alt={content.imageAlt} width="1280" height="800" class={commercialUi.heroImage} fetchpriority="high" />
        </figure>
      </div>
      <div class={commercialUi.heroCopy}>
        <p class:list={[homeEyebrow, commercialUi.eyebrowRow]}><span class={commercialUi.eyebrowRule} aria-hidden="true"></span>Commercial cleaning · Brevard County</p>
        <h1 id="commercial-hero-title" class={commercialUi.heroTitle}>{content.title}</h1>
        <p class={commercialUi.heroLede}>{content.intro}</p>
        <p class={commercialUi.fitNote}>{content.who}</p>
        <div class={commercialUi.heroActions}>
          <Button href={content.quoteHref}>{servicePageDefaults.quoteButtonText} <Icon name="arrow-right" class={commercialUi.actionIcon} /></Button>
          <a class={phone} href={site.phoneHref}>{servicePageDefaults.callButtonPrefix}{site.phoneDisplay}</a>
        </div>
      </div>
    </div>
  </section>

  <section class={commercialUi.checklistSection} aria-labelledby="commercial-included-heading">
    <div class={shell}>
      <div class={commercialUi.checklistHeader}>
        <div>
          <p class:list={[homeEyebrow, commercialUi.eyebrowRow]}><span class={commercialUi.checklistAccent} aria-hidden="true"></span>Routine checklist</p>
          <h2 id="commercial-included-heading" class={commercialUi.checklistHeading}>{content.includedHeading}</h2>
        </div>
        <p class={commercialUi.checklistIntro}>{content.includedIntro}</p>
      </div>

      <ul class={commercialUi.checklistGrid} role="list">
        {content.included.map((item, index) => (
          <li class:list={[commercialUi.checklistItemBase, commercialChecklistItemClass(index)]}>
            <span class={commercialUi.checklistIcon} aria-hidden="true"><Icon name="check-circle" class={commercialUi.checklistIconGlyph} /></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class={commercialUi.pricingSection} aria-labelledby="commercial-price-heading">
    <div class:list={[shell, commercialUi.pricingGrid]}>
      <div>
        <p class={commercialUi.darkEyebrow}>Pricing</p>
        <h2 id="commercial-price-heading" class={commercialUi.pricingTitle}>{content.priceLabel}</h2>
        <p class={commercialUi.pricingCopy}>{content.pricing}</p>
        <ul class={commercialUi.factorList} role="list">
          {content.pricingFactors.map((factor) => (
            <li class={commercialUi.factorItem}><span aria-hidden="true">•</span><span>{factor}</span></li>
          ))}
        </ul>
      </div>

      <div>
        <p class={commercialUi.darkEyebrow}>Service setup</p>
        <h2 class={commercialUi.optionsTitle}>Match the cleaning plan to the workspace.</h2>
        <p class={commercialUi.optionsIntro}>{content.optionsIntro}</p>

        <div class={commercialUi.optionGroups}>
          <section aria-labelledby="commercial-scheduling-heading">
            <h3 id="commercial-scheduling-heading" class={commercialUi.optionGroupHeading}>Scheduling</h3>
            <ul class={commercialUi.optionsList} role="list">
              {content.options.slice(0, 2).map((option) => (
                <li class={commercialUi.optionItemBase}>
                  <span class={commercialUi.optionPlus} aria-hidden="true">+</span>
                  <span class={commercialUi.optionText}>{option}</span>
                </li>
              ))}
            </ul>
          </section>

          <section aria-labelledby="commercial-extras-heading">
            <h3 id="commercial-extras-heading" class={commercialUi.optionGroupHeading}>Additional tasks</h3>
            <ul class={commercialUi.optionsList} role="list">
              {content.options.slice(2).map((option) => (
                <li class={commercialUi.optionItemBase}>
                  <span class={commercialUi.optionPlus} aria-hidden="true">+</span>
                  <span class={commercialUi.optionText}>{option}</span>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </div>
    </div>
  </section>

  <CTA title="Ready to set up your cleaning plan?" quoteHref={content.quoteHref} />
</BaseLayout>
