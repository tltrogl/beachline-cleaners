---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import { shell, faqUi } from '../styles/ui';
import { site, faqContent } from '../data/content';

const faqGroups = [
  { title: 'Booking & pricing', items: faqContent.faqs.slice(0, 3) },
  { title: 'Before, during & after the visit', items: faqContent.faqs.slice(3, 8) },
  { title: 'Services & scope', items: faqContent.faqs.slice(8) },
];
---
<BaseLayout title={`${faqContent.metaTitle} | ${site.name}`} description={faqContent.metaDescription}>
  <section class={faqUi.heroSection}>
    <div class={shell}>
      <p class={faqUi.heroEyebrow}>{faqContent.hero.eyebrow}</p>
      <h1 class={faqUi.heroTitle}>{faqContent.hero.title}</h1>
      <p class={faqUi.heroLede}>{faqContent.hero.lede}</p>
    </div>
  </section>

  <section class={faqUi.section}>
    <div class:list={[shell, faqUi.contentShell]}>
      <div class={faqUi.groups}>
        {faqGroups.map((group, groupIndex) => (
          <section class:list={[faqUi.group, groupIndex > 0 && faqUi.groupBorder]} aria-labelledby={`faq-group-${groupIndex}`}>
            <div class={faqUi.groupHeadingWrap}>
              <span class={faqUi.groupRule} aria-hidden="true"></span>
              <h2 id={`faq-group-${groupIndex}`} class={faqUi.groupHeading}>{group.title}</h2>
            </div>
            <div class={faqUi.list}>
              {group.items.map((faq) => (
                <details class={faqUi.details} open={faq.open}>
                  <summary class={faqUi.summary}>{faq.q}</summary>
                  {'prices' in faq && faq.prices ? (
                    <div class={faqUi.priceBlock}>
                      <dl class={faqUi.priceList}>
                        {faq.prices.map((row) => (
                          <div class={faqUi.priceRow}>
                            <dt class={faqUi.priceLabel}>{row.service}</dt>
                            <dd class={faqUi.priceValue}>{row.price}</dd>
                          </div>
                        ))}
                      </dl>
                      <p class={faqUi.note}>{faq.priceNote}</p>
                    </div>
                  ) : <p class={faqUi.answer}>{faq.a}</p>}
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <CTA title="Still have a question?" text="Call or text us, or send a quote request with the details of your property. We’ll work through anything that isn’t covered here." />
</BaseLayout>
