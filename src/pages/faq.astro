---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import { shell, section, pageHero, pageTitle, eyebrow, lede, details, summary } from '../styles/ui';
import { site, faqContent } from '../data/content';
---
<BaseLayout title={`${faqContent.metaTitle} | ${site.name}`} description={faqContent.metaDescription}>
  <section class={pageHero}>
    <div class={shell}>
      <p class={eyebrow}>{faqContent.hero.eyebrow}</p>
      <h1 class={pageTitle}>{faqContent.hero.title}</h1>
      <p class:list={[lede, "mt-[18px]"]}>{faqContent.hero.lede}</p>
    </div>
  </section>

  <section class={section}>
    <div class:list={[shell, "max-w-[900px]"]}>
      <div class="grid gap-3">
        {faqContent.faqs.map((faq) => (
          <details class={details} open={faq.open}>
            <summary class={summary}>{faq.q}</summary>
            <p class="mt-3">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
