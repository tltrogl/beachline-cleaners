---
import SiteImage from '../components/SiteImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { shell, homeEyebrow, phone } from '../styles/ui';
import { site, servicesDetail, servicePageDefaults, pricingContent } from '../data/content';

const content = servicesDetail.vacationRental;
---
<BaseLayout title={`${content.metaTitle} | ${site.name}`} description={content.metaDescription} quoteHref={content.quoteHref}>
  <section class="border-b border-line bg-mist pt-12 pb-14 max-mobile:pt-7 max-mobile:pb-9" aria-labelledby="rental-hero-title" slot="hero">
    <div class:list={[shell, "grid grid-cols-[.9fr_1.1fr] items-center gap-16 max-tablet:gap-9 max-mobile:grid-cols-1 max-mobile:gap-7"]}>
      <div>
        <p class:list={[homeEyebrow, 'flex items-center gap-3']}><span class="h-px w-10 shrink-0 bg-sea" aria-hidden="true"></span>Vacation rentals</p>
        <h1 id="rental-hero-title" class="max-w-[720px] text-[clamp(2.9rem,4.8vw,4.35rem)] leading-[1.03] tracking-[-.04em] max-mobile:text-[2.75rem]">{content.title}</h1>
        <p class="mt-6 max-w-[610px] text-lede leading-[1.62] max-mobile:mt-4">{content.intro}</p>
        <div class="mt-7 flex flex-wrap items-center gap-control-gap">
          <Button href={content.quoteHref}>{servicePageDefaults.quoteButtonText} <Icon name="arrow-right" class="size-[18px]" /></Button>
          <a class={phone} href={site.phoneHref}>{servicePageDefaults.callButtonPrefix}{site.phoneDisplay}</a>
        </div>
      </div>
      <div class="relative pb-3 pr-3">
        <span class="absolute bottom-0 right-0 h-20 w-32 rounded-panel bg-[#C94F68]" aria-hidden="true"></span>
        <figure class="relative m-0 overflow-hidden rounded-panel bg-white shadow-[0_20px_60px_rgba(28,65,91,.10)]">
        <SiteImage src={content.image} alt={content.imageAlt} width="1280" height="800" class="aspect-[1.14] w-full object-cover object-[70%_center] max-mobile:aspect-[1.5]" fetchpriority="high" />
        </figure>
      </div>
    </div>
  </section>

  <section class="py-[76px] max-mobile:py-14" aria-labelledby="rental-included-heading">
    <div class={shell}>
      <div class="grid grid-cols-[.58fr_1.42fr] gap-16 max-tablet:grid-cols-1 max-tablet:gap-7">
        <div>
          <p class:list={[homeEyebrow, 'flex items-center gap-3']}><span class="h-1 w-10 rounded-full bg-[#C94F68]" aria-hidden="true"></span>Every turnover</p>
          <h2 id="rental-included-heading" class="max-w-[430px]">Clean, reset, and report.</h2>
        </div>
        <ul class="m-0 grid list-none grid-cols-2 gap-x-8 border-t border-line p-0 max-mobile:grid-cols-1" role="list">
          {content.included.map((item, index) => (
            <li class:list={[
              'grid min-h-[96px] grid-cols-[30px_1fr] items-start gap-3 border-b border-line py-5 text-[1.01rem] leading-[1.58]',
              index % 2 === 0 ? 'pr-2' : 'border-l pl-8 max-mobile:border-l-0 max-mobile:pl-0'
            ]}>
              <span class="mt-0.5 text-teal" aria-hidden="true"><Icon name="check-circle" class="size-[18px]" /></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-seafoam py-[70px] max-mobile:py-14" aria-labelledby="rental-price-heading">
    <div class:list={[shell, "grid grid-cols-[1.12fr_.88fr] gap-14 max-tablet:grid-cols-1 max-tablet:gap-10"]}>
      <div>
        <div class="flex items-end justify-between gap-6">
          <div>
            <p class="mb-2 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark">Starting prices</p>
            <h2 id="rental-price-heading" class="text-[clamp(2.1rem,3.5vw,3rem)] tracking-[-.035em]">Turnover pricing.</h2>
          </div>
          <p class="hidden text-[1rem] font-[750] text-sea-dark wide:block">{content.priceLabel}</p>
        </div>
        <div class="mt-6 overflow-hidden rounded-panel border border-line border-t-4 border-t-[#C94F68] bg-white">
          <table class="w-full border-collapse text-left text-small">
            <caption class="sr-only">{pricingContent.rentalHeading}</caption>
            <thead class="bg-mist/55"><tr class="border-b border-line"><th scope="col" class="px-6 py-4 pr-4 font-bold max-mobile:px-4">{pricingContent.propertyColumn}</th><th scope="col" class="px-6 py-4 font-bold max-mobile:px-4">{pricingContent.priceColumn}</th></tr></thead>
            <tbody>
              {content.pricingRows?.map((row) => (
                <tr class="border-b border-line last:border-b-0"><th scope="row" class="px-6 py-4 pr-4 font-normal max-mobile:px-4">{row.property}</th><td class="px-6 py-4 font-bold text-sea-dark max-mobile:px-4">{row.price}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 max-w-[690px] text-[1rem] leading-[1.65]">{content.pricing}</p>
      </div>

      <div class="self-start rounded-panel bg-ocean px-8 py-8 text-white max-mobile:px-6">
        <p class="mb-2 text-eyebrow font-extrabold uppercase tracking-[.12em] text-cyan">By arrangement</p>
        <h2 class="text-[clamp(1.85rem,3vw,2.45rem)] text-white">Optional turnover support.</h2>
        <ul class="mt-6 m-0 list-none border-t border-white/20 p-0" role="list">
          {content.options.map((option) => {
            const [label, price] = option.split(' — ');
            return (
              <li class="grid grid-cols-[30px_minmax(0,1fr)_auto] gap-3 border-b border-white/20 py-[18px] text-white/82">
                <span class="font-black text-cyan" aria-hidden="true">+</span>
                <span class="font-[700]">{label}</span>
                <span class="font-extrabold tabular-nums text-white">{price}</span>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>

  <CTA quoteHref={content.quoteHref} />
</BaseLayout>
