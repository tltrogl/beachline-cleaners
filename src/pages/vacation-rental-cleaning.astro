---
import SiteImage from '../components/SiteImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { shell, homeEyebrow, phone, rentalUi } from '../styles/ui';
import { site, servicesDetail, servicePageDefaults, pricingContent } from '../data/content';

const content = servicesDetail.vacationRental;
---
<BaseLayout title={`${content.metaTitle} | ${site.name}`} description={content.metaDescription} quoteHref={content.quoteHref}>
  <section class={rentalUi.heroSection} aria-labelledby="rental-hero-title" slot="hero">
    <div class:list={[shell, rentalUi.heroGrid]}>
      <div>
        <p class:list={[homeEyebrow, rentalUi.eyebrowRow]}><span class={rentalUi.eyebrowRuleSea} aria-hidden="true"></span>Vacation rental cleaning · Brevard County</p>
        <h1 id="rental-hero-title" class={rentalUi.heroTitle}>{content.title}</h1>
        <p class={rentalUi.heroLede}>{content.intro}</p>
        <p class={rentalUi.fitNote}>{content.who}</p>
        <p class="mt-5 inline-flex rounded-full border border-teal/20 bg-white px-4 py-2 text-[.92rem] font-extrabold text-sea-dark">{content.priceLabel}</p>
        <div class={rentalUi.heroActions}>
          <Button href={content.quoteHref}>{servicePageDefaults.quoteButtonText} <Icon name="arrow-right" class={rentalUi.actionIcon} /></Button>
          <a class={phone} href={site.phoneHref}>{servicePageDefaults.callButtonPrefix}{site.phoneDisplay}</a>
        </div>
      </div>
      <div class={rentalUi.heroMedia}>
        <figure class={rentalUi.heroFigure}>
          <SiteImage src={content.image} alt={content.imageAlt} width="1280" height="800" class={rentalUi.heroImage} fetchpriority="high" />
        </figure>
      </div>
    </div>
  </section>

  <section class={rentalUi.scopeSection} aria-labelledby="rental-included-heading">
    <div class={shell}>
      <div class={rentalUi.scopeGrid}>
        <div>
          <p class:list={[homeEyebrow, rentalUi.eyebrowRow]}><span class={rentalUi.accentRule} aria-hidden="true"></span>Every turnover</p>
          <h2 id="rental-included-heading" class={rentalUi.scopeHeading}>{content.includedHeading}</h2>
          <p class={rentalUi.scopeIntro}>{content.includedIntro}</p>
        </div>
        <ul class={rentalUi.scopeList} role="list">
          {content.included.map((item) => {
            const [label, ...description] = item.split(': ');
            return (
              <li class={rentalUi.scopeItemBase}>
                <span class="mt-0.5 flex size-7 items-center justify-center rounded-full bg-seafoam text-teal" aria-hidden="true"><Icon name="check-circle" class="size-[17px]" /></span>
                <div>
                  <h3 class="text-[1rem] font-extrabold text-ink">{label}</h3>
                  <p class="mt-1 text-[.94rem] leading-[1.55] text-ink-soft">{description.join(': ')}</p>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>

  <section class={rentalUi.pricingSection} aria-labelledby="rental-price-heading">
    <div class:list={[shell, rentalUi.pricingGrid]}>
      <div>
        <div class={rentalUi.pricingHeader}>
          <div>
            <p class={rentalUi.pricingEyebrow}>Starting prices</p>
            <h2 id="rental-price-heading" class={rentalUi.pricingTitle}>Turnover pricing.</h2>
          </div>
          <p class={rentalUi.priceLabel}>{content.priceLabel}</p>
        </div>
        <div class={rentalUi.tableWrap}>
          <table class={rentalUi.table}>
            <caption class="sr-only">{pricingContent.rentalHeading}</caption>
            <thead class={rentalUi.tableHead}><tr class={rentalUi.tableRow}><th scope="col" class={rentalUi.tableHeadCellFirst}>{pricingContent.propertyColumn}</th><th scope="col" class={rentalUi.tableHeadCell}>{pricingContent.priceColumn}</th></tr></thead>
            <tbody>
              {content.pricingRows?.map((row) => (
                <tr class={rentalUi.tableRowBody}><th scope="row" class={rentalUi.tableBodyCellFirst}>{row.property}</th><td class={rentalUi.tableBodyCell}>{row.price}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class={rentalUi.pricingCopy}>{content.pricing}</p>
        <ul class={rentalUi.factorList} role="list">
          {content.pricingFactors.map((factor) => (
            <li class={rentalUi.factorItem}><span aria-hidden="true">•</span><span>{factor}</span></li>
          ))}
        </ul>
      </div>

      <div class={rentalUi.supportPanel}>
        <p class={rentalUi.supportEyebrow}>By arrangement</p>
        <h2 class={rentalUi.supportTitle}>Optional turnover support.</h2>
        <p class={rentalUi.supportIntro}>{content.optionsIntro}</p>
        <ul class={rentalUi.supportList} role="list">
          {content.options.map((option) => {
            const [label, price] = option.split(' — ');
            return (
              <li class={rentalUi.supportRow}>
                <span class={rentalUi.supportPlus} aria-hidden="true">+</span>
                <span class={rentalUi.supportLabel}>{label}</span>
                <span class={rentalUi.supportPrice}>{price}</span>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>

  <CTA title="Ready to simplify turnovers?" quoteHref={content.quoteHref} />
</BaseLayout>
