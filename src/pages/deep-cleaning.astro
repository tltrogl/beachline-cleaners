---
import SiteImage from '../components/SiteImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { shell, homeEyebrow, phone, deepUi } from '../styles/ui';
import { site, servicesDetail, servicePageDefaults } from '../data/content';

const content = servicesDetail.deep;
---
<BaseLayout title={`${content.metaTitle} | ${site.name}`} description={content.metaDescription} quoteHref={content.quoteHref}>
  <section class={deepUi.heroSection} aria-labelledby="deep-hero-title" slot="hero">
    <div class:list={[shell, deepUi.heroGrid]}>
      <div>
        <p class:list={[homeEyebrow, 'flex items-center gap-3']}>
          <span class={deepUi.eyebrowRule} aria-hidden="true"></span>{content.eyebrow}
        </p>
        <h1 id="deep-hero-title" class={deepUi.heroTitle}>{content.title}</h1>
        <p class={deepUi.heroLede}>{content.intro}</p>
        <p class={deepUi.fitNote}>{content.who}</p>
        <div class={deepUi.heroActions}>
          <Button href={content.quoteHref}>{servicePageDefaults.quoteButtonText} <Icon name="arrow-right" class={deepUi.actionIcon} /></Button>
          <a class={phone} href={site.phoneHref}>{servicePageDefaults.callButtonPrefix}{site.phoneDisplay}</a>
        </div>
      </div>

      <div class={deepUi.heroMedia}>
        <div class={deepUi.heroAccent} aria-hidden="true"></div>
        <figure class={deepUi.heroFigure}>
          <SiteImage
            src={content.image}
            alt={content.imageAlt}
            width="1200"
            height="800"
            class={deepUi.heroImage}
            fetchpriority="high"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class={deepUi.scopeSection} aria-labelledby="deep-included-heading">
    <div class:list={[shell, deepUi.scopeGrid]}>
      <div>
        <p class:list={[deepUi.darkEyebrow, 'flex items-center gap-3']}>
          <span class={deepUi.darkEyebrowRule} aria-hidden="true"></span>Deep-clean scope
        </p>
        <h2 id="deep-included-heading" class={deepUi.scopeHeading}>{content.includedHeading}</h2>
        <p class={deepUi.scopeIntro}>{content.includedIntro}</p>
      </div>

      <ul class={deepUi.scopeList} role="list">
        {content.included.map((item, index) => (
          <li class:list={[
            deepUi.scopeItemBase,
            index % 2 === 0 ? deepUi.scopeItemEven : deepUi.scopeItemOdd,
          ]}>
            <span class={deepUi.scopeIcon} aria-hidden="true">
              <Icon name="check-circle" class="size-[18px]" />
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class={deepUi.pricingSection} aria-labelledby="deep-price-heading">
    <div class:list={[shell, deepUi.pricingGrid]}>
      <div class={deepUi.pricePanel}>
        <p class={deepUi.lightEyebrow}>Starting price</p>
        <h2 id="deep-price-heading" class={deepUi.priceTitle}>{content.priceLabel}</h2>
        <p class={deepUi.priceCopy}>{content.pricing}</p>

        <ul class={deepUi.factorList} role="list" aria-label="What affects the deep cleaning price">
          {content.pricingFactors.map((factor) => (
            <li class={deepUi.factorItem}>
              <span class="size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>{factor}
            </li>
          ))}
        </ul>
      </div>

      <div class={deepUi.addonsPanel}>
        <p class={deepUi.lightEyebrow}>Optional extras</p>
        <h2 class={deepUi.addonsTitle}>Interior work, only if you need it</h2>
        <p class={deepUi.addonsIntro}>{content.optionsIntro}</p>
        <ul class={deepUi.addonsList} role="list">
          {content.options.map((option) => {
            const [label, price] = option.split(' — ');
            return (
              <li class={deepUi.addonRow}>
                <span class={deepUi.addonPlus} aria-hidden="true">+</span>
                <span class={deepUi.addonLabel}>{label}</span>
                <span class={deepUi.addonPrice}>{price}</span>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>

  <CTA
    quoteHref={content.quoteHref}
    title="Ready for a deeper clean?"
    text="Tell us about the buildup, the rooms that need the most attention, and any interior extras you want. We’ll confirm the scope, price, and available dates before booking."
  />
</BaseLayout>
