---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTA from '../components/CTA.astro';
import { shell, details, summary, phone } from '../styles/ui';
import { homeContent, pricingContent, servicePageDefaults, servicesDetail, site } from '../data/content';

const content = servicesDetail.deep;
const homeServiceCard = homeContent.servicesSection.services.find((service) => service.href.includes('/residential-cleaning'));
const deepServiceCard = homeContent.servicesSection.services.find((service) => service.href.includes('/deep-cleaning'));
const differenceFaq = content.faqs[0];
const remainingFaqs = content.faqs.slice(1);
---
<BaseLayout title={`${content.metaTitle} | ${site.name}`} description={content.metaDescription} quoteHref={content.quoteHref}>
  <section class="bg-mist pt-12 pb-14 max-mobile:pt-7 max-mobile:pb-9" aria-labelledby="deep-hero-title" slot="hero">
    <div class:list={[shell, "grid grid-cols-[.92fr_1.08fr] items-center gap-14 max-tablet:gap-8 max-mobile:grid-cols-1 max-mobile:gap-7"]}>
      <div>
        <p class="mb-3 flex items-center gap-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark">
          <span class="h-px w-10 shrink-0 bg-sea" aria-hidden="true"></span>
          {content.eyebrow}
        </p>
        <h1 id="deep-hero-title" class="max-w-[700px] text-[clamp(2.7rem,4.5vw,4rem)] leading-[1.08] tracking-[-.03em] max-mobile:text-[2.65rem]">{content.title}</h1>
        <p class="mt-6 max-w-[620px] text-lede leading-[1.6] max-mobile:mt-4">{content.intro}</p>
        <p class="mt-5 text-[1.2rem] font-bold text-sea-dark">{content.priceLabel}</p>
        <p class="mt-2 max-w-[620px] text-small">{pricingContent.note}</p>
        <div class="mt-7 flex flex-wrap items-center gap-control-gap">
          <Button href={content.quoteHref}>{servicePageDefaults.quoteButtonText} <span aria-hidden="true">→</span></Button>
          <a class={phone} href={site.phoneHref}>{servicePageDefaults.callButtonPrefix}{site.phoneDisplay}</a>
        </div>
      </div>

      {deepServiceCard && (
        <figure class="m-0 overflow-hidden rounded-panel bg-white shadow-[0_18px_55px_rgba(28,65,91,.09)]">
          <img
            src={deepServiceCard.image}
            alt="Gloved hand wiping a kitchen stovetop"
            class="aspect-[1.12] w-full object-cover object-center max-mobile:aspect-[1.48]"
            width="1200"
            height="800"
            fetchpriority="high"
          />
        </figure>
      )}
    </div>
  </section>

  <section class="py-[74px] max-mobile:py-14" aria-labelledby="difference-heading">
    <div class={shell}>
      <div class="grid grid-cols-[.7fr_1.3fr] gap-14 max-tablet:grid-cols-1 max-tablet:gap-6">
        <div>
          <p class="mb-3 flex items-center gap-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark">
            <span class="h-px w-10 bg-sea" aria-hidden="true"></span>
            Standard vs. deep
          </p>
          <h2 id="difference-heading" class="max-w-[500px]">{differenceFaq.q}</h2>
        </div>
        <p class="max-w-[760px] text-[1.08rem] leading-[1.72]">Choose routine upkeep or extra attention to buildup. Both cover the main rooms in your home.</p>
      </div>

      <div class="mt-10 grid grid-cols-2 border-y border-line max-mobile:grid-cols-1">
        <article class="py-7 pr-10 max-mobile:border-b max-mobile:border-line max-mobile:pr-0">
          <p class="mb-2 text-eyebrow font-extrabold uppercase tracking-[.11em] text-ink-soft">Standard home cleaning</p>
          <h3 class="text-[1.38rem]">For routine upkeep</h3>
          <p class="mt-3 max-w-[520px] text-[1rem] leading-[1.65]">Kitchen and bathroom surfaces, reachable dusting, floors, and trash.</p>
          <a class="mt-4 inline-flex font-[750] text-sea-dark underline underline-offset-4" href={homeServiceCard?.href ?? "/residential-cleaning/"}>See Home Cleaning</a>
        </article>
        <article class="border-l border-line py-7 pl-10 max-mobile:border-l-0 max-mobile:pl-0">
          <p class="mb-2 text-eyebrow font-extrabold uppercase tracking-[.11em] text-teal">Deep cleaning</p>
          <h3 class="text-[1.38rem]">For buildup and detail work</h3>
          <p class="mt-3 max-w-[520px] text-[1rem] leading-[1.65]">Everything in a standard clean, plus buildup, baseboards, trim, and other detailed areas.</p>
        </article>
      </div>
      <p class="mt-5 text-[1rem] leading-[1.65]"><strong>Quoted separately:</strong> Appliance interiors, cabinet interiors, and interior window glass. These are optional with either service.</p>
    </div>
  </section>

  <section class="border-y border-line py-[74px] max-mobile:py-14" aria-labelledby="detail-heading">
    <div class:list={[shell, "grid grid-cols-[.78fr_1.22fr] gap-16 max-tablet:grid-cols-1 max-tablet:gap-8"]}>
      <div class="border-l-4 border-teal bg-seafoam px-8 py-9 max-mobile:px-6 max-mobile:py-7">
        <p class="mb-3 flex items-center gap-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark">
          <span class="h-px w-10 bg-teal" aria-hidden="true"></span>
          Service scope
        </p>
        <h2 id="detail-heading" class="max-w-[520px]">Where a deep clean goes further.</h2>
        <p class="mt-5 max-w-[500px] text-[1.04rem] leading-[1.68]">{content.who}</p>
      </div>

      <div class="border-y border-line/90">
        {content.included.map((item, index) => (
          <div class="border-b border-line/90 py-5 last:border-b-0">
            <p class:list={["text-[1.04rem] leading-[1.58]", index === 0 && "font-bold text-ink"]}>{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-[74px] max-mobile:py-10" aria-labelledby="pricing-heading">
    <div class={shell}>
      <div class="grid grid-cols-[.85fr_1.15fr] gap-16 max-tablet:grid-cols-1 max-tablet:gap-8">
        <div>
          <p class="mb-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark">Quote factors</p>
          <h2 id="pricing-heading" class="max-w-[470px]">What affects the quote.</h2>
          <p class="mt-5 max-w-[540px] text-[1.04rem] leading-[1.68]">{content.pricing}</p>
        </div>
        <ul class="m-0 mt-5 grid list-none grid-cols-2 gap-x-5 border-t border-line p-0 self-start" role="list">
          {content.pricingFactors.map((factor) => (
            <li class="border-b border-line py-4 text-[.96rem] font-bold text-ink">{factor}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="border-y border-line py-[74px] max-mobile:py-10" aria-labelledby="extras-heading">
    <div class:list={[shell, "grid grid-cols-[1.08fr_.92fr] items-center gap-14 max-tablet:grid-cols-1 max-tablet:gap-8"]}>
      <figure class="m-0 overflow-hidden rounded-panel bg-mist">
        <img
          src={content.image}
          alt={content.imageAlt}
          class="aspect-[1.42] w-full object-cover object-[70%_center] max-mobile:aspect-[1.5]"
          width="1280"
          height="853"
          loading="lazy"
        />
        {content.imageCaption && <figcaption class="border-t border-line bg-white px-4 py-3 text-sm text-ink-soft">{content.imageCaption}</figcaption>}
      </figure>

      <div>
        <p class="mb-3 flex items-center gap-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark">
          <span class="h-px w-10 bg-sea" aria-hidden="true"></span>
          Available extras
        </p>
        <h2 id="extras-heading">Optional interior work.</h2>
        <p class="mt-4 max-w-[560px] text-[1.04rem] leading-[1.68]">{content.optionsIntro}</p>
        <div class="mt-7 border-y border-line">
          {content.options.map((option) => (
            <div class="grid grid-cols-[34px_1fr] items-start border-b border-line py-4 last:border-b-0">
              <span class="font-black text-sea-dark" aria-hidden="true">+</span>
              <p class="font-[700] text-ink">{option}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {remainingFaqs.length > 0 && (
    <section class="py-[74px] max-mobile:py-10" aria-labelledby="faq-heading">
      <div class:list={[shell, "grid grid-cols-[.65fr_1.35fr] gap-14 max-tablet:grid-cols-1 max-tablet:gap-6"]}>
        <div>
          <p class="mb-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark">Questions</p>
          <h2 id="faq-heading">{servicePageDefaults.faqsHeading}</h2>
        </div>
        <div class="grid content-start gap-3">
          {remainingFaqs.map((faq) => (
            <details class={details}>
              <summary class={summary}>{faq.q}</summary>
              <p class="mt-3">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTA quoteHref={content.quoteHref} />
</BaseLayout>
