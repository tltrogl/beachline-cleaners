---
import SiteImage from '../components/SiteImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { shell, homeEyebrow, phone, moveOutUi } from '../styles/ui';
import { site, servicesDetail, servicePageDefaults } from '../data/content';

const content = servicesDetail.moveOut;
---
<BaseLayout title={`${content.metaTitle} | ${site.name}`} description={content.metaDescription} quoteHref={content.quoteHref}>
  <section class={moveOutUi.heroSection} aria-labelledby="move-hero-title" slot="hero">
    <div class:list={[shell, moveOutUi.heroGrid]}>
      <div class={moveOutUi.heroMedia}>
        <figure class={moveOutUi.heroFigure}>
          <SiteImage src={content.image} alt={content.imageAlt} width="1280" height="800" class={moveOutUi.heroImage} fetchpriority="high" />
        </figure>
      </div>
      <div class={moveOutUi.heroCopy}>
        <p class:list={[homeEyebrow, moveOutUi.eyebrowRow]}><span class={moveOutUi.eyebrowRuleSea} aria-hidden="true"></span>Move-in / move-out · Brevard County</p>
        <h1 id="move-hero-title" class={moveOutUi.heroTitle}><span class="whitespace-nowrap">Move-In</span> / <span class="whitespace-nowrap">Move-Out</span> Cleaning</h1>
        <p class={moveOutUi.heroLede}>{content.intro}</p>
        <p class={moveOutUi.fitNote}>{content.who}</p>
        <p class="mt-5 inline-flex rounded-full border border-teal/20 bg-seafoam px-4 py-2 text-[.92rem] font-extrabold text-sea-dark">{content.priceLabel}</p>
        <div class={moveOutUi.heroActions}>
          <Button href={content.quoteHref}>{servicePageDefaults.quoteButtonText} <Icon name="arrow-right" class={moveOutUi.actionIcon} /></Button>
          <a class={phone} href={site.phoneHref}>{servicePageDefaults.callButtonPrefix}{site.phoneDisplay}</a>
        </div>
      </div>
    </div>
  </section>

  <section class={moveOutUi.scopeSection} aria-labelledby="move-included-heading">
    <div class={shell}>
      <div class={moveOutUi.scopeGrid}>
        <div>
          <p class:list={[homeEyebrow, moveOutUi.eyebrowRow]}><span class={moveOutUi.accentRule} aria-hidden="true"></span>Empty-home clean</p>
          <h2 id="move-included-heading" class={moveOutUi.scopeHeading}>{content.includedHeading}</h2>
          <p class={moveOutUi.scopeIntro}>{content.includedIntro}</p>
        </div>
        <ul class={moveOutUi.scopeList} role="list">
          {content.included.map((item) => {
            const [label, ...description] = item.split(': ');
            return (
              <li class={moveOutUi.scopeItemBase}>
                <span class={moveOutUi.scopeIcon} aria-hidden="true"><Icon name="check-circle" class={moveOutUi.scopeIconGlyph} /></span>
                <div>
                  <h3 class="text-[1rem] font-extrabold text-ink">{label}</h3>
                  <p class="mt-1 text-[.94rem] leading-[1.55] text-ink-soft">{description.join(': ')}</p>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>

  <section class={moveOutUi.pricingSection} aria-labelledby="move-price-heading">
    <div class:list={[shell, moveOutUi.pricingGrid]}>
      <div class={moveOutUi.pricePanel}>
        <p class={moveOutUi.lightEyebrow}>Starting price</p>
        <h2 id="move-price-heading" class={moveOutUi.priceTitle}>{content.priceLabel}</h2>
        <p class={moveOutUi.priceCopy}>{content.pricing}</p>
        <ul class={moveOutUi.factorList} role="list">
          {content.pricingFactors.map((factor) => (
            <li class={moveOutUi.factorItem}><span aria-hidden="true">•</span><span>{factor}</span></li>
          ))}
        </ul>
      </div>

      <div class={moveOutUi.addonsPanel}>
        <p class={moveOutUi.lightEyebrow}>Optional extras</p>
        <h2 class={moveOutUi.addonsTitle}>Only if the handoff needs them.</h2>
        <p class={moveOutUi.addonsIntro}>{content.optionsIntro}</p>
        <ul class={moveOutUi.addonsList} role="list">
          {content.options.map((option) => {
            const [label, price] = option.split(' — ');
            return (
              <li class={moveOutUi.addonRow}>
                <span class={moveOutUi.optionPlus} aria-hidden="true">+</span>
                <span class={moveOutUi.addonLabel}>{label}</span>
                <span class={moveOutUi.optionPrice}>{price}</span>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>

  <CTA title="Ready for a clean handoff?" quoteHref={content.quoteHref} />
</BaseLayout>
