---
import SiteImage from '../components/SiteImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { shell, homeEyebrow, phone } from '../styles/ui';
import { site, servicesDetail, servicePageDefaults } from '../data/content';

const content = servicesDetail.moveOut;
---
<BaseLayout title={`${content.metaTitle} | ${site.name}`} description={content.metaDescription} quoteHref={content.quoteHref}>
  <section class="border-b border-line bg-white pt-12 pb-14 max-mobile:pt-7 max-mobile:pb-9" aria-labelledby="move-hero-title" slot="hero">
    <div class:list={[shell, "grid grid-cols-[1.07fr_.93fr] items-center gap-16 max-tablet:gap-9 max-mobile:grid-cols-1 max-mobile:gap-7"]}>
      <div class="relative order-1 pb-3 pl-3 max-mobile:order-2">
        <span class="absolute bottom-0 left-0 h-20 w-28 rounded-panel bg-[#C94F68]" aria-hidden="true"></span>
        <figure class="relative m-0 overflow-hidden rounded-panel bg-mist shadow-[0_20px_58px_rgba(28,65,91,.09)]">
        <SiteImage src={content.image} alt={content.imageAlt} width="1280" height="800" class="aspect-[1.18] w-full object-cover object-left max-mobile:aspect-[1.52]" fetchpriority="high" />
        </figure>
      </div>
      <div class="order-2 max-mobile:order-1">
        <p class:list={[homeEyebrow, 'flex items-center gap-3']}><span class="h-px w-10 shrink-0 bg-sea" aria-hidden="true"></span>Moving</p>
        <h1 id="move-hero-title" class="max-w-[690px] text-[clamp(2.9rem,4.8vw,4.35rem)] leading-[1.03] tracking-[-.04em] max-mobile:text-[2.75rem]">{content.title}</h1>
        <p class="mt-6 max-w-[590px] text-lede leading-[1.62] max-mobile:mt-4">{content.intro}</p>
        <div class="mt-7 flex flex-wrap items-center gap-control-gap">
          <Button href={content.quoteHref}>{servicePageDefaults.quoteButtonText} <Icon name="arrow-right" class="size-[18px]" /></Button>
          <a class={phone} href={site.phoneHref}>{servicePageDefaults.callButtonPrefix}{site.phoneDisplay}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-line bg-mist/55 py-[76px] max-mobile:py-14" aria-labelledby="move-included-heading">
    <div class={shell}>
      <div class="grid grid-cols-[.68fr_1.32fr] gap-16 max-tablet:grid-cols-1 max-tablet:gap-7">
        <div>
          <p class:list={[homeEyebrow, 'flex items-center gap-3']}><span class="h-1 w-10 rounded-full bg-[#C94F68]" aria-hidden="true"></span>Empty-home clean</p>
          <h2 id="move-included-heading" class="max-w-[480px]">Clean the property before the keys change hands.</h2>
        </div>
        <ul class="m-0 grid list-none grid-cols-2 border-t border-line p-0 max-mobile:grid-cols-1" role="list">
          {content.included.map((item, index) => (
            <li class:list={[
              'grid min-h-[98px] grid-cols-[30px_1fr] items-start gap-3 border-b border-line py-5 text-[1.01rem] leading-[1.6]',
              index % 2 === 0 ? 'pr-8 max-mobile:pr-0' : 'border-l pl-8 max-mobile:border-l-0 max-mobile:pl-0'
            ]}>
              <span class="mt-0.5 text-[#D95E43]" aria-hidden="true"><Icon name="check-circle" class="size-[18px]" /></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-[70px] max-mobile:py-14" aria-labelledby="move-price-heading">
    <div class:list={[shell, "grid grid-cols-[.75fr_1.25fr] items-start gap-16 max-tablet:grid-cols-1 max-tablet:gap-10"]}>
      <div>
        <p class="mb-2 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark">Starting price</p>
        <h2 id="move-price-heading" class="text-[clamp(2.4rem,4vw,3.6rem)] tracking-[-.04em]">{content.priceLabel}</h2>
        <p class="mt-4 max-w-[470px] text-[1.02rem] leading-[1.66]">{content.pricing}</p>
      </div>

      <div class="border-l border-line pl-10 max-tablet:border-l-0 max-tablet:border-t max-tablet:pl-0 max-tablet:pt-8">
        <p class="mb-2 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark">Add-ons</p>
        <h2 class="text-[clamp(1.85rem,3vw,2.45rem)]">Only if the handoff needs them.</h2>
        <ul class="mt-6 m-0 grid list-none grid-cols-2 gap-x-8 border-y border-line p-0 max-mobile:grid-cols-1" role="list">
          {content.options.map((option, index) => {
            const [label, price] = option.split(' — ');
            return (
              <li class:list={['grid grid-cols-[30px_minmax(0,1fr)_auto] gap-3 py-5 font-[700] text-ink', index > 0 && 'border-l border-line pl-8 max-mobile:border-l-0 max-mobile:border-t max-mobile:pl-0']}>
                <span class="font-black text-sea-dark" aria-hidden="true">+</span>
                <span>{label}</span>
                <span class="font-extrabold tabular-nums text-sea-dark">{price}</span>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>

  <CTA quoteHref={content.quoteHref} />
</BaseLayout>
