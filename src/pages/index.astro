---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, homeContent, quoteContent } from '../data/content';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SiteImage from '../components/SiteImage.astro';
import { shell, homeEyebrow, indexUi } from '../styles/ui';
---

<BaseLayout
  bodyClass="island-home"
  title={`${site.name} | ${homeContent.metaTitleSuffix}`}
  description={homeContent.metaDescription}
>
  <section
    class={indexUi.heroSection}
    aria-labelledby="hero-title"
    slot="hero"
  >
    <div class:list={[shell, indexUi.heroGrid]}>
      <div class={indexUi.heroCopy}>
        <p class:list={[homeEyebrow, indexUi.eyebrowRow]}>
          <span
            class={indexUi.eyebrowRuleSea}
            aria-hidden="true"
          ></span>
          {homeContent.hero.eyebrow}
        </p>

        <h1
          id="hero-title"
          class={indexUi.heroTitle}
        >
          {homeContent.hero.title}
        </h1>

        <p class={indexUi.heroDescription}>
          {homeContent.hero.description}
        </p>

        <p class={indexUi.heroServiceArea}>
          {homeContent.hero.serviceArea}
        </p>

        <form
          class={indexUi.estimatorForm}
          action={homeContent.hero.quoteHref}
          method="get"
        >
          <div>
            <label
              class={indexUi.fieldLabel}
              for="hero-location"
            >
              {homeContent.hero.estimator.locationLabel}
            </label>

            <input
              class={indexUi.fieldControl}
              id="hero-location"
              name="location"
              autocomplete="postal-code"
              placeholder={homeContent.hero.estimator.locationPlaceholder}
              required
            />
          </div>

          <div>
            <label
              class={indexUi.fieldLabel}
              for="hero-service"
            >
              {homeContent.hero.estimator.serviceLabel}
            </label>

            <select
              class={indexUi.fieldControl}
              id="hero-service"
              name="service"
            >
              {quoteContent.form.service.options.map((option) => (
                <option value={option.value}>
                  {option.label}
                </option>
              ))}
            </select>
          </div>

          <Button
            class={indexUi.estimatorSubmit}
            type="submit"
          >
            {homeContent.hero.ctaButton}
            <Icon
              name="arrow-right"
              class={indexUi.actionIcon}
            />
          </Button>
        </form>

        <a
          class={indexUi.phoneLink}
          href={site.phoneHref}
        >
          <Icon
            name="phone"
            class={indexUi.phoneIcon}
          />
          {homeContent.hero.estimator.phonePrompt}
          {site.phoneDisplay}
        </a>
      </div>

      <div class={indexUi.heroMedia}>
        <SiteImage
          src={homeContent.hero.imageSrc}
          width={homeContent.hero.imageWidth}
          height={homeContent.hero.imageHeight}
          alt={homeContent.hero.imageAlt}
          class={indexUi.heroImage}
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <div
    class={indexUi.trustStrip}
    aria-label={homeContent.trustStrip.ariaLabel}
  >
    <div class:list={[shell, indexUi.trustGrid]}>
      {homeContent.trustStrip.items.map((item) => (
        <div class={indexUi.trustItem}>
          <Icon
            name="check-circle"
            class={indexUi.trustIcon}
          />
          <span>{item}</span>
        </div>
      ))}
    </div>
  </div>

  <section
    class={indexUi.servicesSection}
    aria-labelledby="services-heading"
  >
    <div class={shell}>
      <div class={indexUi.servicesHeader}>
        <div>
          <p class={indexUi.servicesKicker}>
            Our services
          </p>

          <h2
            id="services-heading"
            class={indexUi.servicesHeading}
          >
            What we do
          </h2>
        </div>

        <p class={indexUi.servicesIntro}>
          Straightforward cleaning for homes, rentals,
          moves, and small workspaces across Brevard County.
        </p>
      </div>

      <div
        class={indexUi.servicesGrid}
        role="list"
      >
        {homeContent.servicesSection.services.map((service, index) => (
          <article
            class:list={[
              indexUi.serviceCard,
              index === 4 && indexUi.serviceCardWide
            ]}
            role="listitem"
          >
            <div
              class:list={[
                indexUi.serviceMedia,
                index === 4 && indexUi.serviceMediaWide
              ]}
            >
              <SiteImage
                src={service.image}
                alt={service.imageAlt}
                class={indexUi.serviceImage}
                loading="lazy"
              />

              <span class={indexUi.servicePriceBadge}>
                {service.priceLabel}
              </span>
            </div>

            <div class={indexUi.serviceCardBody}>
              <h3 class={indexUi.serviceTitle}>
                <a
                  class={indexUi.serviceTitleLink}
                  href={service.href}
                >
                  {service.title}
                </a>
              </h3>

              <p class={indexUi.serviceText}>
                {service.text}
              </p>

              <a
                class={indexUi.serviceLink}
                href={service.href}
              >
                {homeContent.servicesSection.linkText}

                <Icon
                  name="arrow-right"
                  class={indexUi.serviceLinkIcon}
                />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section
    class={indexUi.expectSection}
    aria-labelledby="expect-heading"
  >
    <div class:list={[shell, indexUi.expectGrid]}>
      <div>
        <p class:list={[homeEyebrow, indexUi.eyebrowRow]}>
          <span
            class={indexUi.eyebrowRuleSea}
            aria-hidden="true"
          ></span>

          {homeContent.expectSection.eyebrow}
        </p>

        <h2
          id="expect-heading"
          class={indexUi.expectHeading}
        >
          {homeContent.expectSection.heading}
        </h2>

        <p class={indexUi.expectIntro}>
          {homeContent.expectSection.intro}
        </p>
      </div>

      <div class={indexUi.expectItems}>
        {homeContent.expectSection.items.map((item) => (
          <article class={indexUi.expectItem}>
            <span class={indexUi.expectIconWrap}>
              <Icon
                name="check-circle"
                class={indexUi.expectIcon}
              />
            </span>

            <div>
              <h3 class={indexUi.expectItemTitle}>
                {item.title}
              </h3>

              <p class={indexUi.expectItemText}>
                {item.text}
              </p>
            </div>
          </article>
        ))}
      </div>

      <div class={indexUi.expectLinks}>
        <a
          class={indexUi.secondaryLink}
          href={homeContent.expectSection.faqHref}
        >
          {homeContent.expectSection.faqText}
          <Icon
            name="arrow-right"
            class={indexUi.actionIcon}
          />
        </a>

        <a
          class={indexUi.aboutLink}
          href={homeContent.expectSection.aboutHref}
        >
          {homeContent.expectSection.aboutText}
        </a>
      </div>
    </div>
  </section>

  <section
    class={indexUi.processSection}
    aria-labelledby="process-heading"
  >
    <div class={shell}>
      <div class={indexUi.processHeader}>
        <div>
          <p class={indexUi.processEyebrow}>
            <span
              class={indexUi.processEyebrowRule}
              aria-hidden="true"
            ></span>

            {homeContent.processSection.eyebrow}
          </p>

          <h2
            id="process-heading"
            class={indexUi.processHeading}
          >
            {homeContent.processSection.heading}
          </h2>
        </div>

        <p class={indexUi.processIntro}>
          {homeContent.processSection.intro}
        </p>
      </div>

      <ol
        class={indexUi.processList}
        role="list"
      >
        {homeContent.processSection.steps.map((step, index) => (
          <li class={indexUi.processItem}>
            <span class={indexUi.processNumber}>
              0{index + 1}
            </span>

            <span
              class={indexUi.processStepBar}
              aria-hidden="true"
            ></span>

            <h3 class={indexUi.processStepTitle}>
              {step.title}
            </h3>

            <p class={indexUi.processStepText}>
              {step.text}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section
    class={indexUi.contactSection}
    aria-labelledby="contact-heading"
  >
    <div class:list={[shell, indexUi.contactGrid]}>
      <div>
        <p class={indexUi.contactEyebrow}>
          Ready when you are
        </p>

        <h2 id="contact-heading">
          {homeContent.contactBanner.heading}
        </h2>

        <p class={indexUi.contactText}>
          {homeContent.contactBanner.text}
        </p>
      </div>

      <div class={indexUi.contactActions}>
        <Button href={homeContent.contactBanner.quoteHref}>
          {homeContent.contactBanner.ctaButton}

          <Icon
            name="arrow-right"
            class={indexUi.actionIcon}
          />
        </Button>

        <a
          class={indexUi.contactPhone}
          href={site.phoneHref}
        >
          {homeContent.contactBanner.callPrefix}
          {site.phoneDisplay}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
