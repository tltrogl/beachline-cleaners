---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatWeClean from '../components/WhatWeClean.astro';
import { site, homeContent, quoteContent, withBase } from '../data/content';
import Button from '../components/Button.astro';
import { shell, homeEyebrow, outlineLink } from '../styles/ui';
---
<BaseLayout bodyClass="island-home" title={`${site.name} | ${homeContent.metaTitleSuffix}`} description={homeContent.metaDescription}>
  <section class="home-hero bg-cream pt-10 pb-12 max-mobile:pt-6 max-mobile:pb-8" aria-labelledby="hero-title" slot="hero">
    <div class:list={[shell, "home-hero-grid grid grid-cols-[1.1fr_1fr] items-center gap-11 max-tablet:gap-7 max-mobile:grid-cols-1 max-mobile:gap-[22px]"]}>
      <div class="home-hero-copy">
        <p class={homeEyebrow}>
          Professional cleaning • Brevard County
        </p>
        <h1 id="hero-title" class="max-w-[680px] text-[clamp(2.2rem,3.8vw,3.35rem)] leading-[1.1] tracking-[-.03em] text-balance max-mobile:text-[2.125rem] max-mobile:leading-[1.15]">{homeContent.hero.title}</h1>
        <p class="mt-5 max-w-lg text-[1.125rem] max-mobile:mt-[14px] max-mobile:text-base">{homeContent.hero.description}</p>
        <form class="hero-estimator mt-6 mb-[14px] grid grid-cols-[1fr_1.3fr] gap-3 rounded-xl border border-line bg-white p-4 max-mobile:mt-[18px] max-mobile:gap-2.5 max-mobile:p-3" action={homeContent.hero.quoteHref} method="get">
          <div><label class="mb-[5px] block text-xs font-[750] text-ink-soft" for="hero-location">ZIP code or town</label><input class="min-h-11 min-w-0 w-full rounded-md border border-line bg-cream p-[9px] text-[.9rem] focus-visible:outline-3 focus-visible:outline-sea focus-visible:outline-offset-2" id="hero-location" name="location" autocomplete="postal-code" placeholder="e.g. 32931" required /></div>
          <div><label class="mb-[5px] block text-xs font-[750] text-ink-soft" for="hero-service">Cleaning service</label><select class="min-h-11 min-w-0 w-full rounded-md border border-line bg-cream p-[9px] text-[.9rem] focus-visible:outline-3 focus-visible:outline-sea focus-visible:outline-offset-2" id="hero-service" name="service">{quoteContent.form.service.options.map((option) => <option value={option.value}>{option.label}</option>)}</select></div>
          <Button class="col-span-full w-full" type="submit">Get a Quote <span aria-hidden="true">→</span></Button>
        </form>
        <a class="text-[.9rem] font-[650] text-sea-dark underline" href={site.phoneHref}>Prefer to talk? {site.phoneDisplay}</a>
      </div>
      <div class="home-hero-media overflow-hidden rounded-[14px] border border-line bg-cream shadow-site">
        <img
          src={homeContent.hero.imageSrc}
          width={homeContent.hero.imageWidth}
          height={homeContent.hero.imageHeight}
          alt={homeContent.hero.imageAlt}
          class="aspect-[1/1.04] w-full object-cover object-[62%_center] max-mobile:aspect-[1.65] max-mobile:object-center"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <div class="border-b border-line bg-mist" aria-label={homeContent.trustStrip.ariaLabel}>
    <div class:list={[shell, "flex flex-wrap items-center justify-between gap-x-6 gap-y-[14px] py-[18px] max-mobile:grid max-mobile:grid-cols-2 max-mobile:gap-x-3"]}>
      {homeContent.trustStrip.items.map((item) => (
        <div class="inline-flex items-center gap-2 text-[.9rem] font-[750] max-mobile:items-start max-mobile:text-[.78rem]">
          <svg class="shrink-0 text-sea" viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
          </svg>
          <span>{item}</span>
        </div>
      ))}
    </div>
  </div>

  <section class="py-12" aria-labelledby="services-heading">
    <div class={shell}>
      <h2 id="services-heading">{homeContent.servicesSection.heading}</h2>
      <div class="mt-6 grid grid-cols-3 gap-[22px] max-tablet:grid-cols-2 max-mobile:grid-cols-1 max-mobile:gap-5">
        {homeContent.servicesSection.services.map((service, index) => (
          <article class="flex flex-col overflow-hidden rounded-xl border border-line bg-white pb-5 transition-[transform,box-shadow] duration-200 motion-safe:hover:-translate-y-[3px] hover:shadow-lift">
            <img class="h-[180px] w-full object-cover" src={[withBase('/images/hero-living-room.jpg'), withBase('/images/deep-cleaning-kitchen.jpg'), withBase('/images/move-out-empty-room.jpg'), withBase('/images/turnover-active.jpg'), 'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=600&q=80'][index]} alt={['Clean living room after service', 'Detailed cleaning inside a refrigerator', 'Empty room ready for a move', 'Cleaner preparing a guest bed', 'Clean modern office space'][index]} width="600" height="400" loading="lazy" />
            
            <h3 class="mx-5 mt-5"><a class="text-sea-dark no-underline" href={service.href}>{service.title}</a></h3>
            <p class="mx-5 mt-3 mb-3 max-w-[470px] text-[.95rem]">{service.text}</p>
            <a class:list={[outlineLink, "mx-5 mt-auto"]} href={service.href}>{homeContent.servicesSection.linkText} <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <WhatWeClean />

  <section class="border-t border-line bg-mist py-12" aria-labelledby="process-heading">
    <div class={shell}>
      <div class="mb-8">
        <p class={homeEyebrow}>{homeContent.processSection.eyebrow}</p>
        <h2 id="process-heading">{homeContent.processSection.heading}</h2>
      </div>
      <ol class="m-0 grid list-none grid-cols-3 gap-4 p-0 max-tablet:grid-cols-1 max-tablet:gap-3" role="list">
        {homeContent.processSection.steps.map((step) => (
          <li class="flex flex-col rounded-xl border border-line bg-white px-5 py-6 shadow-card max-tablet:px-4 max-tablet:py-[18px]">
            <div class="mb-[18px] inline-flex size-[42px] items-center justify-center rounded-lg bg-mist text-[1.05rem] font-[850] text-sea max-tablet:mb-3 max-tablet:size-[34px] max-tablet:text-[.9rem]" aria-hidden="true">{step.num}</div>
            <h3 class="mb-2.5">{step.title}</h3>
            <p class="text-[.95rem] leading-[1.55]">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-t border-line py-12" aria-labelledby="rental-heading">
    <div class:list={[shell, "grid grid-cols-2 items-center overflow-hidden rounded-[14px] bg-ink text-white max-mobile:grid-cols-1"]}>
      <img
        class="aspect-[1.1] h-full w-full object-cover object-[center_60%] max-mobile:aspect-[2.2]"
        src={homeContent.rentalSection.imageSrc}
        width={homeContent.rentalSection.imageWidth}
        height={homeContent.rentalSection.imageHeight}
        alt={homeContent.rentalSection.imageAlt}
        loading="lazy"
      />
      <div class="p-8 max-mobile:p-5">
        <p class:list={homeEyebrow.replace('text-sea-dark', 'text-rental-text')}>{homeContent.rentalSection.eyebrow}</p>
        <h2 id="rental-heading">{homeContent.rentalSection.heading}</h2>
        <p class="mt-3 text-[1.05rem] text-rental-text">{homeContent.rentalSection.description}</p>
        <a class:list={[outlineLink.replace('text-sea-dark', 'text-rental-text'), 'mt-2.5']} href={homeContent.rentalSection.linkHref}>{homeContent.rentalSection.linkText} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-mist py-10 max-mobile:py-8" aria-labelledby="contact-heading">
    <div class:list={[shell, "flex items-center justify-between gap-7 max-tablet:flex-col max-tablet:items-start"]}>
      <div>
        <h2 id="contact-heading">{homeContent.contactBanner.heading}</h2>
        <p class="mt-3 max-w-[480px]">{homeContent.contactBanner.text}</p>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-[18px] max-mobile:gap-x-[14px] max-mobile:gap-y-[7px]">
        <Button href={homeContent.contactBanner.quoteHref}>{homeContent.contactBanner.ctaButton} <span aria-hidden="true">→</span></Button>
        <a class="text-[.9rem] font-[650] text-sea-dark underline" href={site.phoneHref}>{homeContent.contactBanner.callPrefix}{site.phoneDisplay}</a>
      </div>
    </div>
  </section>
</BaseLayout>
