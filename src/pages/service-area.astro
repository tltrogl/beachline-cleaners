---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { shell, serviceAreaUi, serviceAreaServiceClass } from '../styles/ui';
import { site, serviceAreaContent, withBase } from '../data/content';
---

<BaseLayout
  title={`${serviceAreaContent.metaTitle} | ${site.name}`}
  description={serviceAreaContent.metaDescription}
>
  <section class={serviceAreaUi.heroSection}>
    <div class:list={[shell, serviceAreaUi.heroGrid]}>
      <div>
        <Eyebrow
          variant="teal"
          class={serviceAreaUi.eyebrow}
        >
          {serviceAreaContent.hero.eyebrow}
        </Eyebrow>

        <h1 class={serviceAreaUi.heroTitle}>
          {serviceAreaContent.hero.title}
        </h1>

        <p class={serviceAreaUi.heroLede}>
          {serviceAreaContent.hero.lede}
        </p>

        <div class={serviceAreaUi.heroActions}>
          <Button href={withBase('/quote')}>
            Request a Quote
            <span aria-hidden="true">→</span>
          </Button>

          <a
            class={serviceAreaUi.phoneLink}
            href={site.phoneHref}
          >
            Call {site.phoneDisplay}
          </a>
        </div>
      </div>

      <aside
        class={serviceAreaUi.areaPanel}
        aria-labelledby="service-area-list-heading"
      >
        <span
          class={serviceAreaUi.areaAccent}
          aria-hidden="true"
        ></span>

        <p class={serviceAreaUi.areaKicker}>
          Brevard County
        </p>

        <h2
          id="service-area-list-heading"
          class={serviceAreaUi.areaHeading}
        >
          {serviceAreaContent.areaHeading}
        </h2>

        <ul class={serviceAreaUi.cityList}>
          {serviceAreaContent.areas.map((city) => (
            <li class={serviceAreaUi.city}>
              {city}
            </li>
          ))}
        </ul>

        <p class={serviceAreaUi.areaNote}>
          {serviceAreaContent.areaNote}
        </p>
      </aside>
    </div>
  </section>

  <section class={serviceAreaUi.servicesSection}>
    <div class={shell}>
      <div class={serviceAreaUi.servicesHeader}>
        <div>
          <p class={serviceAreaUi.servicesEyebrow}>
            {serviceAreaContent.coverageEyebrow}
          </p>

          <h2 class={serviceAreaUi.servicesHeading}>
            {serviceAreaContent.coverageHeading}
          </h2>
        </div>

        <p class={serviceAreaUi.coverageIntro}>
          {serviceAreaContent.coverageIntro}
        </p>
      </div>

      <div class={serviceAreaUi.services}>
        {serviceAreaContent.services.map((service, index) => (
          <article class:list={[serviceAreaUi.service, serviceAreaServiceClass(index)]}>
            <span
              class={serviceAreaUi.serviceRule}
              aria-hidden="true"
            ></span>

            <h3 class={serviceAreaUi.serviceTitle}>
              {service.title}
            </h3>

            <p class={serviceAreaUi.serviceText}>
              {service.text}
            </p>

            <a
              class={serviceAreaUi.serviceLink}
              href={service.href}
            >
              {service.linkText}
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTA
    compact
    title={serviceAreaContent.cta.title}
    text={serviceAreaContent.cta.text}
  />
</BaseLayout>
