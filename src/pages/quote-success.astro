---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, quoteSuccessContent } from '../data/content';
import Button from '../components/Button.astro';
import { shell, homeEyebrow, lede, phone, quoteSuccessUi } from '../styles/ui';
---
<BaseLayout bodyClass="island-home no-mobile-bar page-quote-success" title={`${quoteSuccessContent.metaTitle} | ${site.name}`} description={quoteSuccessContent.metaDescription} noindex>
  <section class={quoteSuccessUi.section}>
    <div class:list={[shell, quoteSuccessUi.shell]}>
      <div class={quoteSuccessUi.card}>
        <div class={quoteSuccessUi.iconWrap} aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="40" height="40">
            <path d="M20 6L9 17l-5-5" />
          </svg>
        </div>
        <p class={homeEyebrow}>{quoteSuccessContent.eyebrow}</p>
        <h1 class={quoteSuccessUi.title}>{quoteSuccessContent.title}</h1>
        <p class={lede}>{quoteSuccessContent.lede}</p>
        <div class={quoteSuccessUi.actions}>
          <Button href={quoteSuccessContent.returnButtonHref}>{quoteSuccessContent.returnButtonText}</Button>
          <a class={phone} href={site.phoneHref}>{quoteSuccessContent.callPrefix}{site.phoneDisplay}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
