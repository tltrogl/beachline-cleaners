---
import SiteImage from '../components/SiteImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { shell, homeEyebrow, phone, residentialUi } from '../styles/ui';
import { site, servicesDetail, servicePageDefaults } from '../data/content';

const content = servicesDetail.residential;
const quoteLabel = 'Request a Quote';
---
<BaseLayout title={`${content.metaTitle} | ${site.name}`} description={content.metaDescription} quoteHref={content.quoteHref} quoteLabel={quoteLabel}>
  <section class={residentialUi.heroSection} aria-labelledby="hero-title" slot="hero">
    <div class:list={[shell, residentialUi.heroGrid]}>
      <div>
        <p class:list={[homeEyebrow, 'flex items-center gap-3']}>
          <span class="h-px w-10 shrink-0 bg-sea" aria-hidden="true"></span>{content.eyebrow}
        </p>
        <h1 id="hero-title" class={residentialUi.heroTitle}>{content.title}</h1>
        <p class={residentialUi.heroLede}>{content.intro}</p>

        <div class={residentialUi.cadence} aria-label="Available cleaning schedules">
          <span class={residentialUi.cadenceLabel}>One-time</span>
          <span class={residentialUi.cadenceDot} aria-hidden="true"></span>
          <span class={residentialUi.cadenceLabel}>Weekly</span>
          <span class={residentialUi.cadenceDot} aria-hidden="true"></span>
          <span class={residentialUi.cadenceLabel}>Biweekly</span>
          <span class={residentialUi.cadenceDot} aria-hidden="true"></span>
          <span class={residentialUi.cadenceLabel}>Every 4 weeks</span>
        </div>

        <p class={residentialUi.heroPrice}>
          <span class="size-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          {content.priceLabel}
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-control-gap">
          <Button href={content.quoteHref}>{quoteLabel} <Icon name="arrow-right" class="size-[18px]" /></Button>
          <a class={phone} href={site.phoneHref}>{servicePageDefaults.callButtonPrefix}{site.phoneDisplay}</a>
        </div>
      </div>

      <div class={residentialUi.heroMedia}>
        <figure class={residentialUi.heroFigure}>
          <SiteImage
            src={content.image}
            alt={content.imageAlt}
            width="1200"
            height="800"
            class={residentialUi.heroImage}
            fetchpriority="high"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class={residentialUi.scopeSection} aria-labelledby="included-heading">
    <div class={shell}>
      <div class={residentialUi.scopeHeader}>
        <div>
          <p class:list={[homeEyebrow, 'flex items-center gap-3']}>
            <span class="h-1 w-10 rounded-full bg-accent" aria-hidden="true"></span>Standard clean
          </p>
          <h2 id="included-heading" class={residentialUi.scopeHeading}>{content.includedHeading}</h2>
        </div>
        <p class={residentialUi.scopeIntro}>{content.includedIntro}</p>
      </div>

      <ul class={residentialUi.scopeList} role="list">
        {content.included.map((item) => {
          const [label, ...description] = item.split(': ');
          return (
            <li class={residentialUi.scopeItemBase}>
              <span class={residentialUi.scopeIcon} aria-hidden="true">
                <Icon name="check-circle" class={residentialUi.scopeIconGlyph} />
              </span>
              <div>
                <h3 class={residentialUi.scopeItemTitle}>{label}</h3>
                <p class={residentialUi.scopeItemText}>{description.join(': ')}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class={residentialUi.pricingSection} aria-labelledby="price-heading">
    <div class:list={[shell, residentialUi.pricingGrid]}>
      <div class={residentialUi.pricePanel}>
        <p class={residentialUi.priceEyebrow}>Starting price</p>
        <h2 id="price-heading" class={residentialUi.priceTitle}>{content.priceLabel}</h2>
        <p class={residentialUi.priceCopy}>{content.pricing}</p>

        <ul class={residentialUi.factorList} role="list" aria-label="What affects the price">
          {content.pricingFactors.map((factor) => (
            <li class={residentialUi.factorItem}>
              <span class="size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>{factor}
            </li>
          ))}
        </ul>
      </div>

      <div>
        <div class={residentialUi.addonsHeader}>
          <div>
            <p class={residentialUi.addonsEyebrow}>Optional extras</p>
            <h2 class={residentialUi.addonsTitle}>Add only what you need</h2>
            <p class={residentialUi.addonsIntro}>{content.optionsIntro}</p>
          </div>
        </div>

        <ul class={residentialUi.addonsList} role="list">
          {content.options.map((option) => {
            const [label, price] = option.split(' — ');
            return (
              <li class={residentialUi.addonRow}>
                <span class={residentialUi.addonPlus} aria-hidden="true">+</span>
                <span class={residentialUi.addonLabel}>{label}</span>
                <span class={residentialUi.addonPrice}>{price}</span>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>

  <CTA
    quoteHref={content.quoteHref}
    quoteLabel={quoteLabel}
    title="Ready for a cleaner home?"
    text="Tell us about your home and preferred schedule. We’ll confirm the cleaning scope, price, and available dates before booking."
  />
</BaseLayout>
