---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { shell, homeEyebrow, details, summary } from '../styles/ui';
import { site, servicesDetail, servicePageDefaults, pricingContent, withBase } from '../data/content';

const content = servicesDetail.residential;
---
<BaseLayout title={`${content.title} | ${site.name}`} description={content.intro} quoteHref={content.quoteHref}>
  <section class="bg-mist pt-12 pb-14 max-mobile:pt-7 max-mobile:pb-9" aria-labelledby="hero-title" slot="hero">
    <div class:list={[shell, "grid grid-cols-[.96fr_1.04fr] items-center gap-14 max-tablet:gap-8 max-mobile:grid-cols-1 max-mobile:gap-7"]}>
      <div>
        <p class:list={[homeEyebrow, 'flex items-center gap-3']}>
          <span class="h-px w-10 shrink-0 bg-sea" aria-hidden="true"></span>
          {content.eyebrow}
        </p>
        <h1 id="hero-title" class="max-w-[720px] text-[clamp(2.7rem,4.5vw,4rem)] leading-[1.1] tracking-[-.025em] text-balance max-mobile:text-[2.7rem] max-mobile:leading-[1.08]">{content.title}</h1>
        <p class="mt-6 max-w-[600px] text-[1.16rem] leading-[1.6] max-mobile:mt-4 max-mobile:text-base">{content.intro}</p>
        <div class="mt-6 border-l-4 border-teal pl-4">
          <p class="text-[1.18rem] font-extrabold text-sea-dark">{content.priceLabel}</p>
          <p class="mt-1 max-w-[580px] text-small">{pricingContent.note}</p>
        </div>
        <div class="mt-7 flex flex-wrap items-center gap-4">
          <Button href={content.quoteHref}>{servicePageDefaults.quoteButtonText} <Icon name="arrow-right" class="size-[18px]" /></Button>
          <a class="inline-flex items-center gap-2 text-label font-[650] text-sea-dark underline underline-offset-4" href={site.phoneHref}><Icon name="phone" class="size-4" />{servicePageDefaults.callButtonPrefix}{site.phoneDisplay}</a>
        </div>
      </div>

      <figure class="m-0 overflow-hidden rounded-panel bg-white shadow-[0_18px_55px_rgba(28,65,91,.09)]">
        <img
          src={content.image}
          alt={content.imageAlt}
          width="1200"
          height="800"
          class="aspect-[1.08] w-full object-cover object-[30%_center] max-mobile:aspect-[1.55] max-mobile:object-center"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <div class="border-y border-line bg-white" aria-label="Home cleaning visit options">
    <div class:list={[shell, "grid grid-cols-3 divide-x divide-line py-4 max-mobile:grid-cols-1 max-mobile:divide-x-0 max-mobile:divide-y max-mobile:py-0"]}>
      <div class="flex items-center gap-3 px-6 first:pl-0 max-mobile:px-0 max-mobile:py-3">
        <Icon name="check-circle" class="size-[18px] shrink-0 text-teal" />
        <p class="text-label font-[750] text-ink">One-time cleaning</p>
      </div>
      <div class="flex items-center gap-3 px-6 max-mobile:px-0 max-mobile:py-3">
        <Icon name="check-circle" class="size-[18px] shrink-0 text-teal" />
        <p class="text-label font-[750] text-ink">Weekly service</p>
      </div>
      <div class="flex items-center gap-3 px-6 last:pr-0 max-mobile:px-0 max-mobile:py-3">
        <Icon name="check-circle" class="size-[18px] shrink-0 text-teal" />
        <p class="text-label font-[750] text-ink">Biweekly service</p>
      </div>
    </div>
  </div>

  <section class="py-[76px] max-mobile:py-14" aria-labelledby="standard-clean-heading">
    <div class:list={[shell, "grid grid-cols-[.76fr_1.24fr] gap-16 max-tablet:grid-cols-1 max-tablet:gap-9"]}>
      <div>
        <p class:list={[homeEyebrow, 'flex items-center gap-3']}><span class="h-px w-10 bg-sea" aria-hidden="true"></span>Standard home cleaning</p>
        <h2 id="standard-clean-heading" class="max-w-[500px]">{content.includedHeading}</h2>
        <p class="mt-5 max-w-[500px] text-[1.04rem] leading-[1.68]">{content.includedIntro}</p>
        <div class="mt-8 overflow-hidden rounded-panel bg-mist">
          <img
            src={withBase('/images/cleaner-counter.webp')}
            alt="Man wiping a kitchen counter"
            width="1280"
            height="720"
            class="aspect-[1.5] w-full object-cover object-center"
            loading="lazy"
          />
        </div>
      </div>

      <ul class="m-0 self-start list-none border-b border-line p-0" role="list">
        {content.included.map((item) => (
          <li class="grid grid-cols-[34px_1fr] items-start gap-4 border-t border-line py-5 text-[1.02rem] leading-[1.58]">
            <span class="mt-0.5 flex size-7 items-center justify-center rounded-full bg-cyan/20 text-teal" aria-hidden="true"><Icon name="check-circle" class="size-[17px]" /></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-y border-line bg-seafoam py-[76px] max-mobile:py-10" aria-labelledby="schedule-heading">
    <div class:list={[shell, "grid grid-cols-[.85fr_1.15fr] gap-16 max-tablet:grid-cols-1 max-tablet:gap-9"]}>
      <div>
        <p class:list={[homeEyebrow, 'flex items-center gap-3']}><span class="h-px w-10 bg-sea" aria-hidden="true"></span>Choose your schedule</p>
        <h2 id="schedule-heading" class="max-w-[520px]">One-time, weekly, or biweekly.</h2>
        <p class="mt-5 max-w-[520px] text-[1.04rem] leading-[1.68]">{content.who}</p>
      </div>

      <div>
        <p class="mb-2 text-eyebrow font-extrabold uppercase tracking-[.11em] text-sea-dark">Pricing</p>
        <p class="text-[clamp(1.8rem,3vw,2.45rem)] font-bold leading-[1.2] tracking-[-.02em] text-ink">{content.priceLabel}</p>
        <p class="mt-4 max-w-[620px] text-[1.02rem] leading-[1.65]">{content.pricing}</p>
        <ul class="m-0 mt-5 grid list-none grid-cols-2 gap-x-5 border-t border-line p-0 self-start" role="list">
          {content.pricingFactors.map((factor) => (
            <li class="border-b border-line py-4 text-[.96rem] font-bold text-ink">{factor}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-[76px] max-mobile:py-10" aria-labelledby="extras-heading">
    <div class:list={[shell, "grid grid-cols-[.72fr_1.28fr] gap-16 max-tablet:grid-cols-1 max-tablet:gap-8"]}>
      <div>
        <p class:list={[homeEyebrow, 'flex items-center gap-3']}><span class="h-px w-10 bg-sea" aria-hidden="true"></span>Optional extras</p>
        <h2 id="extras-heading">{servicePageDefaults.optionsHeading}</h2>
        <p class="mt-5 max-w-[500px] text-[1.04rem] leading-[1.68]">{content.optionsIntro}</p>
      </div>

      <ul class="m-0 self-start list-none border-b border-line p-0" role="list">
        {content.options.map((option) => (
          <li class="grid grid-cols-[42px_1fr] items-start gap-3 border-t border-line py-5 text-[1.04rem] font-[700]">
            <span class="text-[1.15rem] font-black text-sea" aria-hidden="true">+</span>
            <span>{option}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {content.faqs.length > 0 && (
    <section class="border-t border-line bg-mist py-[76px] max-mobile:py-10" aria-labelledby="faq-heading">
      <div class:list={[shell, "grid grid-cols-[.65fr_1.35fr] gap-14 max-tablet:grid-cols-1 max-tablet:gap-6"]}>
        <div>
          <p class:list={[homeEyebrow, 'flex items-center gap-3']}><span class="h-px w-10 bg-sea" aria-hidden="true"></span>Questions</p>
          <h2 id="faq-heading">{servicePageDefaults.faqsHeading}</h2>
        </div>
        <div class="grid content-start gap-3">
          {content.faqs.map((faq) => (
            <details class={details}>
              <summary class={summary}>{faq.q}</summary>
              <p class="mt-3">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTA quoteHref={content.quoteHref} />
</BaseLayout>
