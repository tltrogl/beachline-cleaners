---
import SiteImage from '../components/SiteImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { shell, aboutUi } from '../styles/ui';
import { site, aboutContent } from '../data/content';
---
<BaseLayout title={`${aboutContent.metaTitle} | ${site.name}`} description={aboutContent.metaDescription}>
  <section class={aboutUi.heroSection}>
    <div class={shell}>
      <p class={aboutUi.eyebrow}><span class={aboutUi.eyebrowRule} aria-hidden="true"></span>{aboutContent.hero.eyebrow}</p>
      <h1 class={aboutUi.heroTitle}>{aboutContent.hero.title}</h1>
      <p class={aboutUi.heroLede}>{aboutContent.hero.lede}</p>
    </div>
  </section>

  <section class={aboutUi.storySection}>
    <div class:list={[shell, aboutUi.storyGrid]}>
      <div class={aboutUi.storyMedia}>
        <figure class={aboutUi.storyFigure}>
          <SiteImage class={aboutUi.storyImage} src={aboutContent.story.imageSrc} alt={aboutContent.story.imageAlt} />
        </figure>
      </div>

      <div>
        <p class={aboutUi.eyebrow}><span class={aboutUi.eyebrowRuleTeal} aria-hidden="true"></span>{aboutContent.story.eyebrow}</p>
        <h2 class={aboutUi.storyHeading}>{aboutContent.story.heading}</h2>
        <p class={aboutUi.ownerTitle}>{aboutContent.story.ownerTitle}</p>
        <p class={aboutUi.ownerIntro}>{aboutContent.story.ownerIntro}</p>
        {aboutContent.story.paragraphs.map((paragraph) => (
          <p class={aboutUi.storyParagraph}>{paragraph}</p>
        ))}
      </div>
    </div>

    <div class:list={[shell, aboutUi.checkGrid]}>
      {aboutContent.story.checks.map((check, index) => (
        <div class:list={[aboutUi.checkItem, index > 0 && aboutUi.checkItemBorder]}>
          <span class={aboutUi.checkIcon} aria-hidden="true"><Icon name="check-circle" class="size-[17px]" /></span>
          <span>{check}</span>
        </div>
      ))}
    </div>
  </section>

  <CTA title="Ready to talk through your cleaning?" />
</BaseLayout>
