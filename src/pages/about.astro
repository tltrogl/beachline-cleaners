---
import SiteImage from '../components/SiteImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import { shell, section, pageHero, pageTitle, eyebrow, lede, split, splitImage } from '../styles/ui';
import { site, aboutContent } from '../data/content';
---
<BaseLayout title={`${aboutContent.metaTitle} | ${site.name}`} description={aboutContent.metaDescription}>
  <section class={pageHero}>
    <div class={shell}>
      <p class:list={[eyebrow, 'flex items-center gap-3']}><span class="h-px w-10 bg-sea" aria-hidden="true"></span>{aboutContent.hero.eyebrow}</p>
      <h1 class:list={[pageTitle, 'max-w-[780px]']}>{aboutContent.hero.title}</h1>
      <p class:list={[lede, "mt-[18px]"]}>{aboutContent.hero.lede}</p>
    </div>
  </section>

  <section class={section}>
    <div class:list={[shell, split]}>
      <div>
        <SiteImage class={splitImage} src={aboutContent.story.imageSrc} alt={aboutContent.story.imageAlt} />
      </div>
      <div>
        <p class:list={[eyebrow, 'flex items-center gap-3']}><span class="h-px w-10 bg-sea" aria-hidden="true"></span>{aboutContent.story.eyebrow}</p>
        <h2 class="max-w-[620px]">{aboutContent.story.heading}</h2>

        <p class="mt-6 text-nav font-extrabold uppercase tracking-[.1em] text-sea-dark">{aboutContent.story.ownerTitle}</p>
        <p class:list={[lede, "mt-3"]}>{aboutContent.story.ownerIntro}</p>

        {aboutContent.story.paragraphs.map((paragraph) => (
          <p class="mt-4 max-w-[680px]">{paragraph}</p>
        ))}

        <div class="mt-8 border-b border-line">
          {aboutContent.story.checks.map((check) => (
            <div class="grid grid-cols-[14px_1fr] items-center gap-3 border-t border-line py-3.5 font-[700]">
              <span class="size-2 rounded-full bg-teal" aria-hidden="true"></span>
              <span>{check}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
