---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import { shell, section, pageHero, pageTitle, eyebrow, lede, split, splitImage } from '../styles/ui';
import { site, aboutContent } from '../data/content';
---
<BaseLayout title={`${aboutContent.metaTitle} | ${site.name}`} description={aboutContent.metaDescription}>
  <section class={pageHero}>
    <div class={shell}>
      <p class={eyebrow}>{aboutContent.hero.eyebrow}</p>
      <h1 class={pageTitle}>{aboutContent.hero.title}</h1>
      <p class:list={[lede, "mt-[18px]"]}>{aboutContent.hero.lede}</p>
    </div>
  </section>

  <section class={section}>
    <div class:list={[shell, split]}>
      <div>
        <img class={splitImage} src={aboutContent.story.imageSrc} alt={aboutContent.story.imageAlt} />
      </div>
      <div>
        <p class={eyebrow}>{aboutContent.story.eyebrow}</p>
        <h2>{aboutContent.story.heading}</h2>

        <div class="mt-5 rounded-[10px] border-l-[3px] border-sea bg-mist px-5 py-4">
          <p class="text-nav font-bold uppercase tracking-[.06em] text-sea-dark">{aboutContent.story.ownerTitle}</p>
        </div>
        <p class:list={[lede, "mt-5"]}>{aboutContent.story.ownerIntro}</p>

        {aboutContent.story.paragraphs.map((paragraph) => (
          <p class="mt-4">{paragraph}</p>
        ))}

        <div class="mt-7 mb-[34px] grid gap-[13px]">
          {aboutContent.story.checks.map((check) => (
            <div class="check flex items-start gap-3 font-bold">{check}</div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
