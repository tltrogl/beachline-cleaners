---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, quoteContent } from '../data/content';
import Button from '../components/Button.astro';
import { shell, section, homeEyebrow, lede, details, field, formGroup, formRow } from '../styles/ui';
---
<BaseLayout bodyClass="island-home no-mobile-bar page-quote" title={`${quoteContent.metaTitle} | ${site.name}`} description={quoteContent.metaDescription}>
  <section class={section}>
    <div class:list={[shell, "grid grid-cols-[1fr_340px] items-start gap-[70px] max-tablet:grid-cols-1"]}>
      <div>
        <p class={homeEyebrow}>{quoteContent.eyebrow}</p>
        <h1 class="mb-4 text-[clamp(2.4rem,4vw,3.2rem)]">{quoteContent.title}</h1>
        <p class:list={[lede, "mt-4"]}>{quoteContent.lede}</p>

        <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-[.86rem] font-[750] text-sea-dark" aria-label={quoteContent.trustPillsAriaLabel}>
          {quoteContent.trustPills.map((pill) => (
            <span><span aria-hidden="true">✓ </span>{pill}</span>
          ))}
        </div>
        
        <form class="quote-form mt-7 grid max-w-[600px] gap-5" action={quoteContent.form.formspreeEndpoint} method="POST">
          <input type="hidden" name="_next" value="https://beachlinecleaners.com/quote-success/" />
          <input type="hidden" name="_subject" value="New Quote Request from beachlinecleaners.com" />
          <div class="hidden" aria-hidden="true">
            <label>{quoteContent.form.honeypotLabel}</label>
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>

          <div class={formGroup}>
            <label class="text-[.9rem] font-bold" for="name">{quoteContent.form.name.label}</label>
            <input class={field} type="text" id="name" name="name" required autocomplete="name" placeholder={quoteContent.form.name.placeholder} />
          </div>
          <div class={formRow}>
            <div class={formGroup}>
              <label class="text-[.9rem] font-bold" for="phone">{quoteContent.form.phone.label}</label>
              <input
                class={field}
                type="tel"
                id="phone"
                name="phone"
                required
                autocomplete="tel"
                placeholder={quoteContent.form.phone.placeholder}
                pattern={quoteContent.form.phone.pattern}
                title={quoteContent.form.phone.title}
              />
            </div>
            <div class={formGroup}>
              <label class="text-[.9rem] font-bold" for="email">{quoteContent.form.email.label}</label>
              <input
                class={field}
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                placeholder={quoteContent.form.email.placeholder}
              />
            </div>
          </div>
          <div class={formGroup}>
            <label class="text-[.9rem] font-bold" for="location">{quoteContent.form.location.label}</label>
            <input class={field} type="text" id="location" name="location" required placeholder={quoteContent.form.location.placeholder} />
          </div>
          <div class={formGroup}>
            <label class="text-[.9rem] font-bold" for="service">{quoteContent.form.service.label}</label>
            <select class={field} id="service" name="service" required>
              <option value="">{quoteContent.form.service.placeholder}</option>
              {quoteContent.form.service.options.map((opt) => (
                <option value={opt.value}>{opt.label}</option>
              ))}
            </select>
          </div>

          <details class:list={[details, "form-details-toggle mt-1"]}>
            <summary class="inline-flex list-none items-center gap-1.5 text-[.92rem] font-bold text-sea-dark">{quoteContent.form.detailsToggle}</summary>
            <div class="mt-5 grid gap-5">
              <div class={formRow}>
                <div class={formGroup}>
                  <label class="text-[.9rem] font-bold" for="beds_baths">{quoteContent.form.bedsBaths.label}</label>
                  <input class={field} type="text" id="beds_baths" name="beds_baths" placeholder={quoteContent.form.bedsBaths.placeholder} />
                </div>
                <div class={formGroup}>
                  <label class="text-[.9rem] font-bold" for="size">{quoteContent.form.size.label}</label>
                  <input class={field} type="text" id="size" name="size" placeholder={quoteContent.form.size.placeholder} />
                </div>
              </div>
              <div class={formGroup}>
                <label class="text-[.9rem] font-bold" for="frequency">{quoteContent.form.frequency.label}</label>
                <input class={field} type="text" id="frequency" name="frequency" placeholder={quoteContent.form.frequency.placeholder} />
              </div>
              <div class={formGroup}>
                <label class="text-[.9rem] font-bold" for="notes">{quoteContent.form.notes.label}</label>
                <textarea class={field} id="notes" name="notes" rows="3" placeholder={quoteContent.form.notes.placeholder}></textarea>
              </div>
            </div>
          </details>

          <Button type="submit" class="submit-btn mt-2.5 w-full">{quoteContent.form.submitButton} <span aria-hidden="true">→</span></Button>
        </form>
      </div>

      <aside class="sticky top-[110px] rounded-xl bg-mist p-7 max-tablet:static">
        <h3 class="mb-3">{quoteContent.aside.heading}</h3>
        <p class="mb-5 mt-4">{quoteContent.aside.description}</p>
        <div class="grid gap-2.5">
          <Button variant="secondary" class="mt-5 w-full" href={site.phoneHref}>{quoteContent.aside.callPrefix}{site.phoneDisplay}</Button>
          <Button variant="secondary" size="compact" href={quoteContent.aside.textHref}>{quoteContent.aside.textButton}</Button>
        </div>
        
        <h3 class="mt-8 mb-3 text-[1.1rem]">{quoteContent.aside.detailsHeading}</h3>
        <ul class="mt-3 list-disc pl-5 text-[.95rem] text-ink-soft">
          {quoteContent.aside.detailsList.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('.quote-form');
  if (form) {
    const params = new URLSearchParams(window.location.search);
    for (const name of ['location', 'service']) {
      const field = form.elements.namedItem(name);
      if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) {
        const value = params.get(name);
        if (value) field.value = value;
      }
    }

    form.addEventListener('submit', () => {
      const btn = form.querySelector<HTMLButtonElement>('.submit-btn');
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Sending…';
      }
    });
  }
</script>
