---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, quoteContent } from '../data/content';
import '../styles/home.css';
---
<BaseLayout bodyClass="island-home no-mobile-bar page-quote" title={`${quoteContent.metaTitle} | ${site.name}`} description={quoteContent.metaDescription}>
  <section class="section">
    <div class="container content-grid">
      <div class="prose">
        <p class="hero-location">{quoteContent.eyebrow}</p>
        <h1 class="quote-title">{quoteContent.title}</h1>
        <p class="lede">{quoteContent.lede}</p>

        <div class="form-trust-pills" aria-label={quoteContent.trustPillsAriaLabel}>
          {quoteContent.trustPills.map((pill) => (
            <span><span aria-hidden="true">✓ </span>{pill}</span>
          ))}
        </div>
        
        <form class="quote-form" action={site.smsHref} data-phone={site.phoneHref.replace('tel:', '')} data-email={site.email}>
          <p class="quote-delivery-note">Complete the details below, then open a text message to review and send. Your request is sent only when you send the message. You can also open an email draft below.</p>
          <div class="form-group">
            <label for="name">{quoteContent.form.name.label}</label>
            <input type="text" id="name" name="name" required autocomplete="name" placeholder={quoteContent.form.name.placeholder} />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="phone">{quoteContent.form.phone.label}</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                autocomplete="tel"
                placeholder={quoteContent.form.phone.placeholder}
                pattern={quoteContent.form.phone.pattern}
                title={quoteContent.form.phone.title}
              />
            </div>
            <div class="form-group">
              <label for="email">{quoteContent.form.email.label}</label>
              <input
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                placeholder={quoteContent.form.email.placeholder}
              />
            </div>
          </div>
          <div class="form-group">
            <label for="location">{quoteContent.form.location.label}</label>
            <input type="text" id="location" name="location" required placeholder={quoteContent.form.location.placeholder} />
          </div>
          <div class="form-group">
            <label for="service">{quoteContent.form.service.label}</label>
            <select id="service" name="service" required>
              <option value="">{quoteContent.form.service.placeholder}</option>
              {quoteContent.form.service.options.map((opt) => (
                <option value={opt.value}>{opt.label}</option>
              ))}
            </select>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="beds_baths">{quoteContent.form.bedsBaths.label}</label>
              <input type="text" id="beds_baths" name="beds_baths" placeholder={quoteContent.form.bedsBaths.placeholder} />
            </div>
            <div class="form-group">
              <label for="size">{quoteContent.form.size.label}</label>
              <input type="text" id="size" name="size" placeholder={quoteContent.form.size.placeholder} />
            </div>
          </div>
          <div class="form-group">
            <label for="frequency">{quoteContent.form.frequency.label}</label>
            <input type="text" id="frequency" name="frequency" placeholder={quoteContent.form.frequency.placeholder} />
          </div>
          <div class="form-group">
            <label for="notes">{quoteContent.form.notes.label}</label>
            <textarea id="notes" name="notes" rows="4" placeholder={quoteContent.form.notes.placeholder}></textarea>
          </div>
          <button type="submit" class="btn btn-primary submit-btn" name="channel" value="sms">Continue by text</button>
          <button type="submit" class="btn btn-secondary" name="channel" value="email">Continue by email</button>
        </form>
      </div>

      <aside class="aside-card">
        <h3>{quoteContent.aside.heading}</h3>
        <p class="aside-description">{quoteContent.aside.description}</p>
        <div class="aside-actions">
          <a class="btn btn-secondary aside-call-btn" href={site.phoneHref}>{quoteContent.aside.callPrefix}{site.phoneDisplay}</a>
          <a class="text-contact-btn" href={quoteContent.aside.textHref}>{quoteContent.aside.textButton}</a>
        </div>
        
        <h3 class="aside-details-title">{quoteContent.aside.detailsHeading}</h3>
        <ul class="aside-details-list">
          {quoteContent.aside.detailsList.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('.quote-form');
  if (form) {
    const params = new URLSearchParams(window.location.search);
    for (const name of ['location', 'service']) {
      const field = form.elements.namedItem(name);
      if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) {
        const value = params.get(name);
        if (value) field.value = value;
      }
    }
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const labels: Record<string, string> = {name: 'Name', phone: 'Phone', email: 'Email', location: 'Property', service: 'Service', beds_baths: 'Beds/baths', size: 'Square feet', frequency: 'Schedule', notes: 'Notes'};
      const details = Object.entries(labels).flatMap(([key, label]) => {
        const value = String(data.get(key) ?? '').trim();
        if (!value) return [];
        const service = form.elements.namedItem('service');
        return [`${label}: ${key === 'service' && service instanceof HTMLSelectElement ? service.selectedOptions[0].text : value}`];
      });
      const message = `I'd like a cleaning quote.\n${details.join('\n')}`;
      if (event.submitter instanceof HTMLButtonElement && event.submitter.value === 'email') {
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Cleaning quote request')}&body=${encodeURIComponent(message)}`;
        return;
      }
      const separator = /iPhone|iPad|iPod/.test(navigator.userAgent) ? '&' : '?';
      window.location.href = `sms:${form.dataset.phone}${separator}body=${encodeURIComponent(message)}`;
    });
  }
</script>

<style>
  .quote-title {
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    margin-bottom: 16px;
  }
  .form-trust-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 20px;
    font-size: 0.86rem;
    font-weight: 750;
    color: var(--sea-dark);
  }
  .quote-form {
    margin-top: 28px;
    display: grid;
    gap: 20px;
    max-width: 600px;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-group label {
    font-size: 0.9rem;
    font-weight: 700;
  }
  .form-group input,
  .form-group select,
  .form-group textarea {
    font-family: inherit;
    font-size: 1rem;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fdfdfd;
    transition: border-color 0.2s, outline 0.2s;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: 3px solid var(--sea);
    outline-offset: 1px;
    border-color: var(--sea);
  }
  .submit-btn {
    width: 100%;
    margin-top: 10px;
  }
  .aside-description {
    margin-bottom: 20px;
  }
  .aside-actions {
    display: grid;
    gap: 10px;
  }
  .aside-call-btn {
    width: 100%;
    justify-content: center;
  }
  .aside-details-title {
    margin-top: 32px;
    font-size: 1.1rem;
  }
  .aside-details-list {
    padding-left: 20px;
    font-size: 0.95rem;
    margin-top: 12px;
    color: var(--ink-soft);
  }
  .text-contact-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: white;
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 750;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .text-contact-btn:hover {
    border-color: var(--sea);
    background: var(--mist);
  }
  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
