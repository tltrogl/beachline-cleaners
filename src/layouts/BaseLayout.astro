---
import { SEO } from 'astro-seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, accessibilityContent, mobileActionBarContent, withBase } from '../data/content';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '../styles/site.css';

interface Props {
  title?: string;
  bodyClass?: string;
  description?: string;
  noindex?: boolean;
  quoteHref?: string;
}

const {
  title = site.name,
  bodyClass = '',
  description = site.defaultMetaDescription,
  noindex = false,
  quoteHref = mobileActionBarContent.quoteHref
} = Astro.props;
const hideMobileBar = bodyClass.includes('no-mobile-bar');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SEO
      title={title}
      description={description}
      noindex={noindex}
      canonical={new URL(Astro.url.pathname, Astro.site).toString()}
      openGraph={{
        basic: {
          title: title,
          type: "website",
          image: new URL(withBase('/og-image.jpg'), Astro.site).toString(),
        },
        optional: {
          description: description,
          siteName: site.name,
        }
      }}
      twitter={{
        card: "summary_large_image",
        title: title,
        description: description,
        image: new URL(withBase('/og-image.jpg'), Astro.site).toString(),
      }}
    />
    <meta name="theme-color" content="#0b7fa6" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HouseCleaningService",
      "name": site.name,
      "telephone": site.phoneHref.replace('tel:', ''),
      "areaServed": site.areaServed,
      "priceRange": site.priceRange,
      "description": description
    })} />
  </head>
  <body class:list={["group/site", bodyClass, bodyClass.includes("island-home") && "bg-paper", !hideMobileBar && "max-mobile:pb-[calc(56px+env(safe-area-inset-bottom))]"]}>
    <a class="fixed -top-[100px] left-4 z-[100] bg-white px-[18px] py-3 text-ink focus:top-3" href="#main-content">{accessibilityContent.skipToContent}</a>
    <Header quoteHref={quoteHref} />
    <main id="main-content" class="scroll-mt-20" tabindex="-1">
      <slot name="hero" />
      <slot />
    </main>
    <Footer quoteHref={quoteHref} />
    {!hideMobileBar && <div class="mobile-action-bar fixed inset-x-0 bottom-0 z-[70] hidden min-h-14 w-full grid-cols-[1fr_1fr_1.3fr] border-t border-line bg-white pb-[env(safe-area-inset-bottom)] max-mobile:grid" aria-label={mobileActionBarContent.ariaLabel}>
      <a class="flex min-h-12 items-center justify-center text-compact-action font-[850] no-underline" href={site.phoneHref}>{mobileActionBarContent.callLabel}</a>
      <a class="flex min-h-12 items-center justify-center border-l border-line text-compact-action font-[850] no-underline" href={site.smsHref}>{mobileActionBarContent.textLabel}</a>
      <a class="mobile-quote flex min-h-12 items-center justify-center border-l border-line bg-sea text-compact-action font-[850] text-white no-underline hover:bg-sea-dark active:bg-sea-dark" href={quoteHref}>{mobileActionBarContent.quoteLabel}</a>
    </div>}
  </body>
</html>
