xt-sea-dark aria-[current=page]:text-sea-dark aria-[current=page]:underline underline-offset-4 group-[.island-home]/site:mobile:max-wide:text-nav-compact group-[.island-home]/site:max-mobile:text-small nav-phone whitespace-nowrap max-[1021px]:hidden max-mobile:block group-[.island-home]/site:mobile:max-wide:hidden" href="tel:+13213239776">Call (321) 323-9776</a> <a href="/quote/?service=residential" class="inline-flex items-center justify-center gap-control-gap rounded-lg border no-underline transition-[transform,background,border-color] duration-200 motion-safe:not-disabled:hover:-translate-y-0.5 motion-safe:active:translate-y-0 disabled:cursor-wait disabled:opacity-70 border-transparent bg-sea-dark text-white shadow-[0_8px_22px_rgba(0,101,145,.16)] hover:bg-teal active:bg-teal min-h-[50px] px-control-x text-nav font-extrabold group-[.island-home]/site:mobile:max-wide:text-nav-compact group-[.island-home]/site:max-mobile:text-small max-mobile:w-full group-[.island-home]/site:mobile:max-wide:px-3">Get a Quote</a> </nav> </div> </header> <script type="module">const t=document.querySelector(".mobile-toggle"),n=document.querySelector("#nav-links");t?.addEventListener("click",()=>{const s=n?.classList.toggle("open")??!1;t.setAttribute("aria-expanded",String(s))});document.addEventListener("click",s=>{const e=s.target;if(!(e instanceof Node))return;const o=document.querySelector(".nav-services");o?.open&&!o.contains(e)&&(o.open=!1),n?.classList.contains("open")&&!n.contains(e)&&!t?.contains(e)&&(n.classList.remove("open"),t?.setAttribute("aria-expanded","false"))});document.addEventListener("keydown",s=>{if(s.key!=="Escape")return;const e=document.querySelector(".nav-services");e?.open?(e.open=!1,e.querySelector("summary")?.focus()):n?.classList.contains("open")&&(n.classList.remove("open"),t?.setAttribute("aria-expanded","false"),t instanceof HTMLElement&&t.focus())});</script> <main id="main-content" class="scroll-mt-20" tabindex="-1"> <section class="bg-mist pt-12 pb-14 max-mobile:pt-7 max-mobile:pb-9" aria-labelledby="hero-title"> <div class="mx-auto w-[min(calc(100%-40px),1180px)] max-mobile:w-[min(calc(100%-28px),1180px)] group-[.island-home]/site:max-mobile:w-[calc(100%-36px)] grid grid-cols-[.96fr_1.04fr] items-center gap-14 max-tablet:gap-8 max-mobile:grid-cols-1 max-mobile:gap-7"> <div> <p class="mb-[17px] text-eyebrow font-extrabold uppercase tracking-[.11em] text-sea-dark max-mobile:mb-3 max-mobile:text-eyebrow-mobile max-mobile:tracking-[.06em] flex items-center gap-3"> <span class="h-px w-10 shrink-0 bg-sea" aria-hidden="true"></span> Home cleaning </p> <h1 id="hero-title" class="max-w-[720px] text-[clamp(2.7rem,4.5vw,4rem)] leading-[1.1] tracking-[-.025em] text-balance max-mobile:text-[2.7rem] max-mobile:leading-[1.08]">Home cleaning that keeps the week from getting away from you.</h1> <p class="mt-6 max-w-[600px] text-[1.16rem] leading-[1.6] max-mobile:mt-4 max-mobile:text-base">We handle the routine cleaning—kitchens, bathrooms, floors, dusting, and living areas—whether you need a one-time clean or regular weekly or biweekly service.</p> <div class="mt-6 border-l-4 border-teal pl-4"> <p class="text-[1.18rem] font-extrabold text-sea-dark">From $125 per visit</p> <p class="mt-1 max-w-[580px] text-small">Starting prices give you a ballpark. We’ll confirm the actual price before you book based on the property, its condition, cleaning frequency, and any extras you want.</p> </div> <div class="mt-7 flex flex-wrap items-center gap-4"> <a href="/quote/?service=residential" class="inline-flex items-center justify-center gap-control-gap rounded-lg border no-underline transition-[transform,background,border-color] duration-200 motion-safe:not-disabled:hover:-translate-y-0.5 motion-safe:active:translate-y-0 disabled:cursor-wait disabled:opacity-70 border-transparent bg-sea-dark text-white shadow-[0_8px_22px_rgba(0,101,145,.16)] hover:bg-teal active:bg-teal min-h-[50px] px-control-x text-action font-extrabold">Get a Quote<svg class="shrink-0 size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"> <path d="M4 12h16m-6-6 6 6-6 6"></path>   </svg></a> <a class="inline-flex items-center gap-2 text-label font-[650] text-sea-dark underline underline-offset-4" href="tel:+13213239776"><svg class="shrink-0 size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">  <path d="M6.5 3h3l1.5 5-2.5 2a15 15 0 0 0 5.5 5.5l2-2.5 5 1.5v3a3 3 0 0 1-3 3C10.5 20.5 3.5 13.5 3.5 6a3 3 0 0 1 3-3Z"></path>  </svg>Call (321) 323-9776</a> </div> </div> <figure class="m-0 overflow-hidden rounded-panel bg-white shadow-[0_18px_55px_rgba(28,65,91,.09)]"> <img src="/images/cleaner-living-room.webp" alt="Man vacuuming a furnished coastal living room" width="1200" height="800" class="aspect-[1.08] w-full object-cover object-[30%_center] max-mobile:aspect-[1.55] max-mobile:object-center" fetchpriority="high"> </figure> </div> </section>   <div class="border-y border-line bg-white" aria-label="Home cleaning visit options"> <div class="mx-auto w-[min(calc(100%-40px),1180px)] max-mobile:w-[min(calc(100%-28px),1180px)] group-[.island-home]/site:max-mobile:w-[calc(100%-36px)] grid grid-cols-3 divide-x divide-line py-4 max-mobile:grid-cols-1 max-mobile:divide-x-0 max-mobile:divide-y max-mobile:py-0"> <div class="flex items-center gap-3 px-6 first:pl-0 max-mobile:px-0 max-mobile:py-3"> <svg class="shrink-0 size-[18px] shrink-0 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">   <circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path> </svg> <p class="text-label font-[750] text-ink">One-time cleaning</p> </div> <div class="flex items-center gap-3 px-6 max-mobile:px-0 max-mobile:py-3"> <svg class="shrink-0 size-[18px] shrink-0 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">   <circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path> </svg> <p class="text-label font-[750] text-ink">Weekly service</p> </div> <div class="flex items-center gap-3 px-6 last:pr-0 max-mobile:px-0 max-mobile:py-3"> <svg class="shrink-0 size-[18px] shrink-0 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">   <circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path> </svg> <p class="text-label font-[750] text-ink">Biweekly service</p> </div> </div> </div> <section class="py-[76px] max-mobile:py-14" aria-labelledby="standard-clean-heading"> <div class="mx-auto w-[min(calc(100%-40px),1180px)] max-mobile:w-[min(calc(100%-28px),1180px)] group-[.island-home]/site:max-mobile:w-[calc(100%-36px)] grid grid-cols-[.76fr_1.24fr] gap-16 max-tablet:grid-cols-1 max-tablet:gap-9"> <div> <p class="mb-[17px] text-eyebrow font-extrabold uppercase tracking-[.11em] text-sea-dark max-mobile:mb-3 max-mobile:text-eyebrow-mobile max-mobile:tracking-[.06em] flex items-center gap-3"><span class="h-px w-10 bg-sea" aria-hidden="true"></span>Standard home cleaning</p> <h2 id="standard-clean-heading" class="max-w-[500px]">What’s included in a standard clean</h2> <p class="mt-5 max-w-[500px] text-[1.04rem] leading-[1.68]">This is the core home-cleaning checklist. If you need something beyond it, we can add that to the quote—no extras are required.</p> <div class="mt-8 overflow-hidden rounded-panel bg-mist"> <img src="/images/cleaner-counter.webp" alt="Man wiping a kitchen counter" width="1280" height="720" class="aspect-[1.5] w-full object-cover object-center" loading="lazy"> </div> </div> <ul class="m-0 self-start list-none border-b border-line p-0" role="list"> <li class="grid grid-cols-[34px_1fr] items-start gap-4 border-t border-line py-5 text-[1.02rem] leading-[1.58]"> <span class="mt-0.5 flex size-7 items-center justify-center rounded-full bg-cyan/20 text-teal" aria-hidden="true"><svg class="shrink-0 size-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">   <circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path> </svg></span> <span>Kitchen counters, sink, cabinet fronts, appliance exteriors, and floors</span> </li><li class="grid grid-cols-[34px_1fr] items-start gap-4 border-t border-line py-5 text-[1.02rem] leading-[1.58]"> <span class="mt-0.5 flex size-7 items-center justify-center rounded-full bg-cyan/20 text-teal" aria-hidden="true"><svg class="shrink-0 size-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">   <circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path> </svg></span> <span>Bathroom toilets, showers, tubs, sinks, mirrors, counters, fixtures, and floors</span> </li><li class="grid grid-cols-[34px_1fr] items-start gap-4 border-t border-line py-5 text-[1.02rem] leading-[1.58]"> <span class="mt-0.5 flex size-7 items-center justify-center rounded-full bg-cyan/20 text-teal" aria-hidden="true"><svg class="shrink-0 size-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">   <circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path> </svg></span> <span>Dusting reachable surfaces and cleaning mirrors in bedrooms and living areas</span> </li><li class="grid grid-cols-[34px_1fr] items-start gap-4 border-t border-line py-5 text-[1.02rem] leading-[1.58]"> <span class="mt-0.5 flex size-7 items-center justify-center rounded-full bg-cyan/20 text-teal" aria-hidden="true"><svg class="shrink-0 size-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">   <circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path> </svg></span> <span>Vacuuming and mopping appropriate floor surfaces</span> </li><li class="grid grid-cols-[34px_1fr] items-start gap-4 border-t border-line py-5 text-[1.02rem] leading-[1.58]"> <span class="mt-0.5 flex size-7 items-center justify-center rounded-full bg-cyan/20 text-teal" aria-hidden="true"><svg class="shrink-0 size-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">   <circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path> </svg></span> <span>Trash removal and basic room reset</span> </li> </ul> </div> </section> <section class="border-y border-line bg-seafoam py-[76px] max-mobile:py-10" aria-labelledby="schedule-heading"> <div class="mx-auto w-[min(calc(100%-40px),1180px)] max-mobile:w-[min(calc(100%-28px),1180px)] group-[.island-home]/site:max-mobile:w-[calc(100%-36px)] grid grid-cols-[.85fr_1.15fr] gap-16 max-tablet:grid-cols-1 max-tablet:gap-9"> <div> <p class="mb-[17px] text-eyebrow font-extrabold uppercase tracking-[.11em] text-sea-dark max-mobile:mb-3 max-mobile:text-eyebrow-mobile max-mobile:tracking-[.06em] flex items-center gap-3"><span class="h-px w-10 bg-sea" aria-hidden="true"></span>Choose your schedule</p> <h2 id="schedule-heading" class="max-w-[520px]">One-time, weekly, or biweekly.</h2> <p class="mt-5 max-w-[520px] text-[1.04rem] leading-[1.68]">Book a one-time clean to catch up, or choose weekly or biweekly visits for routine upkeep.</p> </div> <div> <p class="mb-2 text-eyebrow font-extrabold uppercase tracking-[.11em] text-sea-dark">Pricing</p> <p class="text-[clamp(1.8rem,3vw,2.45rem)] font-bold leading-[1.2] tracking-[-.02em] text-ink">From $125 per visit</p> <p class="mt-4 max-w-[620px] text-[1.02rem] leading-[1.65]">We base the quote on the size of the home, bedrooms and bathrooms, current condition, and how often you want service. If there’s heavier buildup, we may recommend starting with a deep clean before moving to regular maintenance.</p> <ul class="m-0 mt-5 grid list-none grid-cols-2 gap-x-5 border-t border-line p-0 self-start" role="list"> <li class="border-b border-line py-4 text-[.96rem] font-bold text-ink">Square footage</li><li class="border-b border-line py-4 text-[.96rem] font-bold text-ink">Bedrooms &amp; bathrooms</li><li class="border-b border-line py-4 text-[.96rem] font-bold text-ink">Condition &amp; buildup</li><li class="border-b border-line py-4 text-[.96rem] font-bold text-ink">Cleaning frequency</li> </ul> </div> </div> </section> <section class="py-[76px] max-mobile:py-10" aria-labelledby="extras-heading"> <div class="mx-auto w-[min(calc(100%-40px),1180px)] max-mobile:w-[min(calc(100%-28px),1180px)] group-[.island-home]/site:max-mobile:w-[calc(100%-36px)] grid grid-cols-[.72fr_1.28fr] gap-16 max-tablet:grid-cols-1 max-tablet:gap-8"> <div> <p class="mb-[17px] text-eyebrow font-extrabold uppercase tracking-[.11em] text-sea-dark max-mobile:mb-3 max-mobile:text-eyebrow-mobile max-mobile:tracking-[.06em] flex items-center gap-3"><span class="h-px w-10 bg-sea" aria-hidden="true"></span>Optional extras</p> <h2 id="extras-heading">Options &amp; Add-ons</h2> <p class="mt-5 max-w-[500px] text-[1.04rem] leading-[1.68]">Need a little more done? Appliance interiors, empty cabinet interiors, and interior windows can be added to your quote. If you only need the standard clean, leave the extras off.</p> </div> <ul class="m-0 self-start list-none border-b border-line p-0" role="list"> <li class="grid grid-cols-[42px_1fr] items-start gap-3 border-t border-line py-5 text-[1.04rem] font-[700]"> <span class="text-[1.15rem] font-black text-sea" aria-hidden="true">+</span> <span>Inside refrigerator and oven</span> </li><li class="grid grid-cols-[42px_1fr] items-start gap-3 border-t border-line py-5 text-[1.04rem] font-[700]"> <span class="text-[1.15rem] font-black text-sea" aria-hidden="true">+</span> <span>Inside cabinets (if emptied)</span> </li><li class="grid grid-cols-[42px_1fr] items-start gap-3 border-t border-line py-5 text-[1.04rem] font-[700]"> <span class="text-[1.15rem] font-black text-sea" aria-hidden="true">+</span> <span>Interior windows</span> </li> </ul> </div> </section> <section class="border-t border-line bg-mist py-[76px] max-mobile:py-10" aria-labelledby="faq-heading"> <div class="mx-auto w-[min(calc(100%-40px),1180px)] max-mobile:w-[min(calc(100%-28px),1180px)] group-[.island-home]/site:max-mobile:w-[calc(100%-36px)] grid grid-cols-[.65fr_1.35fr] gap-14 max-tablet:grid-cols-1 max-tablet:gap-6"> <div> <p class="mb-[17px] text-eyebrow font-extrabold uppercase tracking-[.11em] text-sea-dark max-mobile:mb-3 max-mobile:text-eyebrow-mobile max-mobile:tracking-[.06em] flex items-center gap-3"><span class="h-px w-10 bg-sea" aria-hidden="true"></span>Questions</p> <h2 id="faq-heading">Service FAQs</h2> </div> <div class="grid content-start gap-3"> <details class="rounded-panel border border-line bg-white px-5 py-[19px] open:border-sea-dark/50"> <summary class="flex min-h-6 items-center justify-between gap-4 list-none cursor-pointer font-[850] text-ink hover:text-sea-dark">What should I do before you arrive?</summary> <p class="mt-3">You don’t need to clean first. Pick up loose items, clothing, and toys, and clear dishes from the sink so we can reach the surfaces and floors. Tell us about pets, delicate surfaces, or product preferences. We’ll arrange access ahead of time. If cabinet interiors are included in your clean, empty them before we arrive.</p> </details><details class="rounded-panel border border-line bg-white px-5 py-[19px] open:border-sea-dark/50"> <summary class="flex min-h-6 items-center justify-between gap-4 list-none cursor-pointer font-[850] text-ink hover:text-sea-dark">What isn’t included in a standard home clean?</summary> <p class="mt-3">Standard cleaning covers reachable surfaces. Baseboard and trim detailing are part of a deep clean. Appliance interiors, empty cabinet interiors, and interior windows are optional extras. Moving heavy furniture or appliances, organizing clutter, washing dishes, and laundry are outside the standard home-cleaning checklist. Rental laundry and restocking can be arranged separately.</p> </details><details class="rounded-panel border border-line bg-white px-5 py-[19px] open:border-sea-dark/50"> <summary class="flex min-h-6 items-center justify-between gap-4 list-none cursor-pointer font-[850] text-ink hover:text-sea-dark">Do I need to be home?</summary> <p class="mt-3">Either is fine. If you’ll be out, we’ll agree on secure property access before the appointment.</p> </details><details class="rounded-panel border border-line bg-white px-5 py-[19px] open:border-sea-dark/50"> <summary class="flex min-h-6 items-center justify-between gap-4 list-none cursor-pointer font-[850] text-ink hover:text-sea-dark">Do you bring supplies?</summary> <p class="mt-3">We bring standard cleaning supplies and equipment for routine service. If your home has delicate surfaces, product preferences, or sensitivities, tell us before the visit.</p> </details><details class="rounded-panel border border-line bg-white px-5 py-[19px] open:border-sea-dark/50"> <summary class="flex min-h-6 items-center justify-between gap-4 list-none cursor-pointer font-[850] text-ink hover:text-sea-dark">What if I have pets?</summary> <p class="mt-3">Pets are welcome. If your pet may become anxious, act aggressively, or get in the way, please keep them in a secure area during the clean.</p> </details> </div> </div> </section><section class="border-y border-white/10 bg-ocean text-white py-[66px] max-mobile:py-12"> <div class="mx-auto w-[min(calc(100%-40px),1180px)] max-mobile:w-[min(calc(100%-28px),1180px)] group-[.island-home]/site:max-mobile:w-[calc(100%-36px)] grid grid-cols-[1fr_auto] items-center max-tablet:grid-cols-1 gap-10"> <div> <p class="mb-3 flex items-center gap-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-cyan"><span class="h-px w-10 bg-cyan" aria-hidden="true"></span>Next step</p> <h2 class="max-w-[720px] leading-[1.1] tracking-[-.035em] text-white text-[clamp(2.25rem,4.2vw,3.8rem)]">Need a cleaner?</h2> <p class="mt-4 max-w-[680px] text-[1.02rem] leading-[1.65] text-white/70">Tell us what you need cleaned and when you need it. We’ll work through the details with you and confirm the price before anything is booked.</p> </div> <div class="flex flex-wrap items-center gap-3 max-mobile:w-full max-mobile:[&>*]:grow"> <a href="/quote/?service=residential" class="inline-flex items-center justify-center gap-control-gap rounded-lg border no-underline transition-[transform,background,border-color] duration-200 motion-safe:not-disabled:hover:-translate-y-0.5 motion-safe:active:translate-y-0 disabled:cursor-wait disabled:opacity-70 border-transparent bg-white text-sea-dark hover:bg-mist active:bg-seafoam min-h-[50px] px-control-x text-action font-extrabold">Get a Quote<span aria-hidden="true">→</span></a> <a href="tel:+13213239776" class="inline-flex items-center justify-center gap-control-gap rounded-lg border no-underline transition-[transform,background,border-color] duration-200 motion-safe:not-disabled:hover:-translate-y-0.5 motion-safe:active:translate-y-0 disabled:cursor-wait disabled:opacity-70 border-[1.5px] border-white/70 bg-transparent text-white hover:border-white hover:bg-white/15 active:bg-white/25 min-h-[50px] px-control-x text-action font-extrabold">Call (321) 323-9776</a> </div> </div> </section>  </main> <footer class="footer bg-footer pt-7 pb-5 text-white group-[.island-home]/site:bg-footer max-mobile:pt-6 max-mobile:pb-[calc(64px+env(safe-area-inset-bottom))] group-[.no-m