nd-home]/site:mobile:max-wide:text-nav-compact group-[.island-home]/site:max-mobile:text-small nav-phone whitespace-nowrap max-[1021px]:hidden max-mobile:block group-[.island-home]/site:mobile:max-wide:hidden" href="tel:+13213239776">Call (321) 323-9776</a> <a href="/quote/" class="inline-flex items-center justify-center gap-control-gap rounded-lg border no-underline transition-[transform,background,border-color] duration-200 motion-safe:not-disabled:hover:-translate-y-0.5 motion-safe:active:translate-y-0 disabled:cursor-wait disabled:opacity-70 border-transparent bg-sea-dark text-white shadow-[0_8px_22px_rgba(0,101,145,.16)] hover:bg-teal active:bg-teal min-h-[50px] px-control-x text-nav font-extrabold group-[.island-home]/site:mobile:max-wide:text-nav-compact group-[.island-home]/site:max-mobile:text-small max-mobile:w-full group-[.island-home]/site:mobile:max-wide:px-3">Get a Quote</a> </nav> </div> </header> <script type="module">const t=document.querySelector(".mobile-toggle"),n=document.querySelector("#nav-links");t?.addEventListener("click",()=>{const s=n?.classList.toggle("open")??!1;t.setAttribute("aria-expanded",String(s))});document.addEventListener("click",s=>{const e=s.target;if(!(e instanceof Node))return;const o=document.querySelector(".nav-services");o?.open&&!o.contains(e)&&(o.open=!1),n?.classList.contains("open")&&!n.contains(e)&&!t?.contains(e)&&(n.classList.remove("open"),t?.setAttribute("aria-expanded","false"))});document.addEventListener("keydown",s=>{if(s.key!=="Escape")return;const e=document.querySelector(".nav-services");e?.open?(e.open=!1,e.querySelector("summary")?.focus()):n?.classList.contains("open")&&(n.classList.remove("open"),t?.setAttribute("aria-expanded","false"),t instanceof HTMLElement&&t.focus())});</script> <main id="main-content" class="scroll-mt-20" tabindex="-1"> <section class="home-hero bg-mist pt-12 pb-14 max-mobile:pt-7 max-mobile:pb-9" aria-labelledby="hero-title"> <div class="mx-auto w-[min(calc(100%-40px),1180px)] max-mobile:w-[min(calc(100%-28px),1180px)] group-[.island-home]/site:max-mobile:w-[calc(100%-36px)] home-hero-grid grid grid-cols-[.96fr_1.04fr] items-center gap-14 max-tablet:gap-8 max-mobile:grid-cols-1 max-mobile:gap-7"> <div class="home-hero-copy"> <p class="mb-[17px] text-eyebrow font-extrabold uppercase tracking-[.11em] text-sea-dark max-mobile:mb-3 max-mobile:text-eyebrow-mobile max-mobile:tracking-[.06em] flex items-center gap-3"> <span class="h-px w-10 shrink-0 bg-sea" aria-hidden="true"></span> LOCAL CLEANING • BREVARD COUNTY </p> <h1 id="hero-title" class="max-w-[760px] text-[clamp(2.7rem,4.5vw,4rem)] leading-[1.1] tracking-[-.025em] text-balance max-mobile:text-[2.7rem] max-mobile:leading-[1.08]">A clean home. More time for you.</h1> <p class="mt-6 max-w-[560px] text-[1.16rem] leading-[1.6] max-mobile:mt-4 max-mobile:text-base">Owner-operated cleaning for your home. Choose recurring visits, a one-time clean, or a deeper reset.</p> <p class="mt-3 max-w-[560px] text-small">Serving Cocoa, Cocoa Beach, Cape Canaveral, Merritt Island, Rockledge, Melbourne, Palm Bay, Viera, and Titusville, with nearby locations by request.</p> <form class="hero-estimator mt-7 mb-4 grid grid-cols-[1fr_1.3fr] gap-3 rounded-panel border border-line bg-white p-4 shadow-[0_14px_40px_rgba(28,65,91,.08)] max-mobile:mt-5 max-mobile:grid-cols-1 max-mobile:gap-2.5 max-mobile:p-3" action="/quote/" method="get"> <div><label class="mb-[5px] block text-sm font-[750] text-ink-soft" for="hero-location">Where do you need cleaning?</label><input class="min-h-11 min-w-0 w-full rounded-md border border-field-line bg-white p-[9px] text-label text-ink placeholder:text-ink-soft hover:border-ink-soft focus-visible:outline-3 focus-visible:outline-sea-dark focus-visible:outline-offset-2" id="hero-location" name="location" autocomplete="postal-code" placeholder="ZIP code or town" required></div> <div><label class="mb-[5px] block text-sm font-[750] text-ink-soft" for="hero-service">What type of cleaning?</label><select class="min-h-11 min-w-0 w-full rounded-md border border-field-line bg-white p-[9px] text-label text-ink placeholder:text-ink-soft hover:border-ink-soft focus-visible:outline-3 focus-visible:outline-sea-dark focus-visible:outline-offset-2" id="hero-service" name="service"><option value="residential">Home Cleaning</option><option value="commercial">Commercial Cleaning</option><option value="deep">Deep Cleaning</option><option value="move">Move-in / Move-out</option><option value="vacation">Vacation Rental</option><option value="other">Other</option></select></div> <button type="submit" class="inline-flex items-center justify-center gap-control-gap rounded-lg border no-underline transition-[transform,background,border-color] duration-200 motion-safe:not-disabled:hover:-translate-y-0.5 motion-safe:active:translate-y-0 disabled:cursor-wait disabled:opacity-70 border-transparent bg-sea-dark text-white shadow-[0_8px_22px_rgba(0,101,145,.16)] hover:bg-teal active:bg-teal min-h-[50px] px-control-x text-action font-extrabold col-span-full w-full">Request a Quote<svg class="shrink-0 size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"> <path d="M4 12h16m-6-6 6 6-6 6"></path>   </svg></button> </form> <a class="inline-flex items-center gap-2 text-label font-[650] text-sea-dark underline underline-offset-4" href="tel:+13213239776"><svg class="shrink-0 size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">  <path d="M6.5 3h3l1.5 5-2.5 2a15 15 0 0 0 5.5 5.5l2-2.5 5 1.5v3a3 3 0 0 1-3 3C10.5 20.5 3.5 13.5 3.5 6a3 3 0 0 1 3-3Z"></path>  </svg>Rather talk it through? (321) 323-9776</a> </div> <div class="home-hero-media overflow-hidden rounded-panel bg-white shadow-[0_18px_55px_rgba(28,65,91,.09)]"> <img src="/images/cleaner-counter.webp" width="1280" height="720" alt="Man wiping a kitchen counter in a bright coastal home" class="aspect-[1.04] w-full object-cover object-[62%_center] max-mobile:aspect-[1.55] max-mobile:object-center" fetchpriority="high"> </div> </div> </section>   <div class="border-y border-line bg-white" aria-label="Key service assurances"> <div class="mx-auto w-[min(calc(100%-40px),1180px)] max-mobile:w-[min(calc(100%-28px),1180px)] group-[.island-home]/site:max-mobile:w-[calc(100%-36px)] grid grid-cols-4 divide-x divide-line py-4 max-mobile:grid-cols-2 max-mobile:divide-x-0 max-mobile:gap-y-3"> <div class="flex items-center justify-center gap-2 px-5 text-label font-[750] first:pl-0 last:pr-0 max-mobile:justify-start max-mobile:px-0 max-mobile:text-nav-compact"> <svg class="shrink-0 size-[18px] shrink-0 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">   <circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path> </svg> <span>Local &amp; owner-operated</span> </div><div class="flex items-center justify-center gap-2 px-5 text-label font-[750] first:pl-0 last:pr-0 max-mobile:justify-start max-mobile:px-0 max-mobile:text-nav-compact"> <svg class="shrink-0 size-[18px] shrink-0 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">   <circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path> </svg> <span>Scope &amp; price agreed first</span> </div><div class="flex items-center justify-center gap-2 px-5 text-label font-[750] first:pl-0 last:pr-0 max-mobile:justify-start max-mobile:px-0 max-mobile:text-nav-compact"> <svg class="shrink-0 size-[18px] shrink-0 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">   <circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path> </svg> <span>Standard supplies included</span> </div><div class="flex items-center justify-center gap-2 px-5 text-label font-[750] first:pl-0 last:pr-0 max-mobile:justify-start max-mobile:px-0 max-mobile:text-nav-compact"> <svg class="shrink-0 size-[18px] shrink-0 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">   <circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path> </svg> <span>Call or text us directly</span> </div> </div> </div> <section class="py-[76px] max-mobile:py-14" aria-labelledby="services-heading"> <div class="mx-auto w-[min(calc(100%-40px),1180px)] max-mobile:w-[min(calc(100%-28px),1180px)] group-[.island-home]/site:max-mobile:w-[calc(100%-36px)]"> <div class="mb-10 grid grid-cols-[.65fr_1fr] items-end gap-10 max-mobile:grid-cols-1 max-mobile:gap-3"> <div> <p class="mb-[17px] text-eyebrow font-extrabold uppercase tracking-[.11em] text-sea-dark max-mobile:mb-3 max-mobile:text-eyebrow-mobile max-mobile:tracking-[.06em] flex items-center gap-3"><span class="h-px w-10 bg-sea" aria-hidden="true"></span>What we do</p> <h2 id="services-heading" class="max-w-[560px]">Choose the cleaning you need.</h2> </div> <p class="max-w-[570px] justify-self-end text-[1.04rem] leading-[1.65] max-mobile:justify-self-start">Regular home cleaning, deeper resets, move cleans, rental turnovers, and small commercial spaces—start with the service that best matches the job.</p> </div> <div class="grid grid-cols-[.82fr_1.18fr] items-start gap-14 max-tablet:grid-cols-1 max-tablet:gap-9"> <div> <a class="group/service-image block overflow-hidden rounded-panel bg-mist" href="/residential-cleaning/" aria-label="See service details: Home Cleaning"> <img class="aspect-[1.12] w-full object-cover object-center transition-transform duration-500 motion-safe:group-hover/service-image:scale-[1.015] max-mobile:aspect-[1.55]" src="/images/cleaner-living-room.webp" alt="Man vacuuming a furnished coastal living room" width="900" height="800" loading="lazy"> </a> <div class="mt-5 border-l-4 border-teal pl-5"> <p class="text-eyebrow font-extrabold uppercase tracking-[.12em] text-teal">Most common starting point</p> <p class="mt-2 max-w-[470px] text-[1rem] leading-[1.6]">Routine upkeep starts with Home Cleaning. If the property needs heavier detail work, a move clean, a guest turnover, or workplace service, choose the matching service.</p> </div> </div> <div class="border-y border-line" role="list"> <article class="group/service grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-5 border-b border-line py-5 last:border-b-0 max-mobile:grid-cols-1" role="listitem"> <div class="min-w-0"> <p class="mb-1 text-eyebrow font-extrabold uppercase tracking-[.1em] text-ink-soft">Regular upkeep</p> <h3 class="text-[1.23rem]"><a class="text-ink no-underline hover:text-sea-dark" href="/residential-cleaning/">Home Cleaning</a></h3> <p class="mt-1.5 text-small leading-[1.55]">Routine cleaning for kitchens, bathrooms, floors, dusting, and living areas—one time or on a regular schedule.</p> </div> <div class="min-w-[132px] text-right max-mobile:mt-3 max-mobile:min-w-0 max-mobile:text-left"> <p class="text-small font-bold text-sea-dark">From $125 per visit</p> <a class="mt-2 inline-flex items-center gap-2 text-link font-[750] text-sea-dark underline underline-offset-4" href="/residential-cleaning/">See service details<svg class="shrink-0 size-4 transition-transform duration-200 motion-safe:group-hover/service:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"> <path d="M4 12h16m-6-6 6 6-6 6"></path>   </svg></a> </div> </article><article class="group/service grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-5 border-b border-line py-5 last:border-b-0 max-mobile:grid-cols-1" role="listitem"> <div class="min-w-0"> <p class="mb-1 text-eyebrow font-extrabold uppercase tracking-[.1em] text-ink-soft">Catch-up clean</p> <h3 class="text-[1.23rem]"><a class="text-ink no-underline hover:text-sea-dark" href="/deep-cleaning/">Deep Cleaning</a></h3> <p class="mt-1.5 text-small leading-[1.55]">A more detailed clean for buildup, baseboards, trim, fans, window tracks, fixtures, and other reachable detail work.</p> </div> <div class="min-w-[132px] text-right max-mobile:mt-3 max-mobile:min-w-0 max-mobile:text-left"> <p class="text-small font-bold text-sea-dark">From $275 per visit</p> <a class="mt-2 inline-flex items-center gap-2 text-link font-[750] text-sea-dark underline underline-offset-4" href="/deep-cleaning/">See service details<svg class="shrink-0 size-4 transition-transform duration-200 motion-safe:group-hover/service:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"> <path d="M4 12h16m-6-6 6 6-6 6"></path>   </svg></a> </div> </article><article class="group/service grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-5 border-b border-line py-5 last:border-b-0 max-mobile:grid-cols-1" role="listitem"> <div class="min-w-0"> <p class="mb-1 text-eyebrow font-extrabold uppercase tracking-[.1em] text-ink-soft">Moving</p> <h3 class="text-[1.23rem]"><a class="text-ink no-underline hover:text-sea-dark" href="/move-out-cleaning/">Move-In / Move-Out</a></h3> <p class="mt-1.5 text-small leading-[1.55]">Detailed empty-home cleaning for a move, inspection, handoff, listing, or closing—including empty cabinet and drawer interiors.</p> </div> <div class="min-w-[132px] text-right max-mobile:mt-3 max-mobile:min-w-0 max-mobile:text-left"> <p class="text-small font-bold text-sea-dark">From $350 per visit</p> <a class="mt-2 inline-flex items-center gap-2 text-link font-[750] text-sea-dark underline underline-offset-4" href="/move-out-cleaning/">See service details<svg class="shrink-0 size-4 transition-transform duration-200 motion-safe:group-hover/service:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"> <path d="M4 12h16m-6-6 6 6-6 6"></path>   </svg></a> </div> </article><article class="group/service grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-5 border-b border-line py-5 last:border-b-0 max-mobile:grid-cols-1" role="listitem"> <div class="min-w-0"> <p class="mb-1 text-eyebrow font-extrabold uppercase tracking-[.1em] text-ink-soft">Guest turnovers</p> <h3 class="text-[1.23rem]"><a class="text-ink no-underline hover:text-sea-dark" href="/vacation-rental-cleaning/">Vacation Rentals</a></h3> <p class="mt-1.5 text-small leading-[1.55]">Cleaning, reset, completion photos, and condition notes between guest stays, built around checkout and check-in times.</p> </div> <div class="min-w-[132px] text-right max-mobile:mt-3 max-mobile:min-w-0 max-mobile:text-left"> <p class="text-small font-bold text-sea-dark">From $125 per turnover</p> <a class="mt-2 inline-flex items-center gap-2 text-link font-[750] text-sea-dark underline underline-offset-4" href="/vacation-rental-cleaning/">See service details<svg class="shrink-0 size-4 transition-transform duration-200 motion-safe:group-hover/service:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"> <path d="M4 12h16m-6-6 6 6-6 6"></path>   </svg></a> </div> </article><article class="group/service grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-5 border-b border-line py-5 last:border-b-0 max-mobile:grid-cols-1" role="listitem"> <div class="min-w-0"> <p class="mb-1 text-eyebrow font-extrabold uppercase tracking-[.1em] text-ink-soft">Workspaces</p> <h3 class="text-[1.23rem]"><a class="text-ink no-underline hover:text-sea-dark" href="/commercial-cleaning/">Commercial Cleaning</a></h3> <p class="mt-1.5 text-small leading-[1.55]">Routine cleaning for small offices, professional suites, retail spaces, restrooms, and breakrooms on an agreed checklist and schedule.</p> </div> <div class="min-w-[132px] text-right max-mobile:mt-3 max-mobile:min-w-0 max-mobile:text-left"> <p class="text-small font-bold text-sea-dark">Custom quote</p> <a class="mt-2 inline-flex items-center gap-2 text-link font-[750] text-sea-dark underline underline-offset-4" href="/commercial-cleaning/">See service details<svg class="shrink-0 size-4 transition-transform duration-200 motion-safe:group-hover/service:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"> <path d="M4 12h16m-6-6 6 6-6 6"></path>   </svg></a> </div> </article> </div> </div> <p class="mt-7 max-w-[800px] text-small">Starting prices give you a ballpark. We’ll confirm the actual price before you book based on the property, its condition, cleaning frequency, and any extras you want.</p> </div> </section> <section class="border-y border-line bg-seafoam py-[76px] max-mobile:py-14" aria-labelledby="what-we-clean-heading"> <div class="mx-auto w-[min(calc(100%-40px),1180px)] max-mobile:w-[min(calc(100%-28px),1180px)] group-[.island-home]/site:max-mobile:w-[calc(100%-36px)] grid grid-cols-[.7fr_1.3fr] gap-16 max-tablet:grid-cols-1 max-tablet:gap-8"> <div> <p class="mb-[17px] text-eyebrow font-extrabold uppercase tracking-[.11em] text-sea-dark max-mobile:mb-3 max-mobile:text-eyebrow-mobile max-mobile:tracking-[.06em] flex items-center gap-3"><span class="h-px w-10 bg-sea" aria-hidden="true"></span>Room by room</p> <h2 id="what-we-clean-heading">What’s included in a standard clean.</h2> <p class="mt-5 max-w-[430px] text-[1.04rem] leading-[1.68]">This is the core checklist for a standard home clean. We’ll confirm the price, scope, and appointment before anything is booked.</p> <p class="mt-6 max-w-[440px] text-small leading-[1.6] text-ink-soft">Need baseboard detailing or the inside of an appliance cleaned? Ask about a deep clean or optional extras.</p> <a class="inline-flex min-h-11 items-center gap-control-gap text-link font-[750] text-sea-dark underline underline-offset-4 mt-6" href="/residential-cleaning/">Explore home cleaning tasks <svg class="shrink-0 size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"> <path d="M4 12h16m-6-6 6 6-6 6"></path>   </svg></a> </div> <div class="border-b border-line"> <div class="grid grid-cols-[14px_150px_1fr] items-start gap-5 border-t border-line py-5 max-mobile:grid-cols-[14px_1fr] max-mobile:gap-x-3 max-mobile:gap-y-1"> <span class="mt-2 size-2 rounded-full bg-teal" aria-hidden="true"></span> <h3 class="text-[1.05rem] max-mobile:col-start-2">Kitchen</h3> <p class="text-small leading-[1.55] max-mobile:col-start-2">Counters, sink, cabinet fronts, appliance exteriors, and floors.</p> </div><div class="grid grid-cols-[14px_150px_1fr] items-start gap-5 border-t border-line py-5 max-mobile:grid-cols-[14px_1fr] max-mobile:gap-x-3 max-mobile:gap-y-1"> <span class="mt-2 size-2 rounded-full bg-teal" aria-hidden="true"></span> <h3 class="text-[1.05rem] max-mobile:col-start-2">Bathrooms</h3> <p class="text-small leading-[1.55] max-mobile:col-start-2">Toilets, showers, tubs, mirrors, counters, fixtures, and floors.</p> </div><div class="grid grid-cols-[14px_150px_1fr] items-start gap-5 border-t border-line py-5 max-mobile:grid-cols-[14px_1fr] max-mobile:gap-x-3 max-mobile:gap-y-1"> <span class="mt-2 size-2 rounded-full bg-teal" aria-hidden="true"></span> <h3 class="text-[1.05rem] max-mobile:col-start-2">Bedrooms</h3> <p class="text-small leading-[1.55] max-mobile:col-start-2">Reachable surfaces and mirrors, floor cleaning, and a basic room reset.</p> </div><div class="grid grid-cols-[14px_150px_1fr] items-start gap-5 border-t border-line py-5 max-mobile:grid-cols-[14px_1fr] max-mobile:gap-x-3 max-mobile:gap-y-1"> <span class="mt-2 size-2 rounded-full bg-teal" aria-hidden="true"></span> <h3 class="text-[1.05rem] max-mobile:col-start-2">Living areas</h3> <p class="text-small leading-[1.55] max-mobile:col-start-2">Reachable surfaces and mirrors, plus vacuuming or mopping as appropriate.</p> </div><div class="grid grid-cols-[14px_150px_1fr] items-start gap-5 border-t border-line py-5 max-mobile:grid-cols-[14px_1fr] max-mobile:gap-x-3 max-mobile:gap-y-1"> <span class="mt-2 size-2 rounded-full bg-teal" aria-hidden="true"></span> <h3 class="text-[1.05rem] max-mobile:col-start-2">Floors &amp; finishing</h3> <p class="text-small leading-[1.55] max-mobile:col-start-2">Vacuuming and mopping appropriate floor surfaces, plus trash removal.</p> </div> </div> </div> </section> <section class="border-y border-line bg-white py-8 max-mobile:py-7" aria-labelledby="expect-heading"> <div class="mx-auto w-[min(calc(100%-40px),1180px)] max-mobile:w-[min(calc(100%-28px),1180px)] group-[.island-home]/site:max-mobile:w-[calc(100%-36px)] grid grid-cols-[.78fr_1.42fr_auto] items-center gap-9 max-tablet:grid-cols-1 max-tablet:gap-5"> <div> <p class="mb-[17px] text-eyebrow font-extrabold uppercase tracking-[.11em] text-sea-dark max-mobile:mb-3 max-mobile:text-eyebrow-mobile max-mobile:tracking-[.06em] flex items-center gap-3"><span class="h-px w-10 bg-sea" aria-hidden="true"></span>Before we arrive</p> <h2 id="expect-heading" class="max-w-[430px] text-[1.45rem] leading-[1.2]">Supplies and access, sorted ahead of time.</h2> <p class="mt-2 max-w-[500px] text-[.96rem] leading-[1.55]">We bring the standard supplies and work out property access before the appointment.</p> </div> <div class="grid grid-cols-2 divide-x divide-line border-y border-line max-mobile:grid-cols-1 max-mobile:divide-x-0 max-mobile:divide-y"> <article class="flex gap-3 px-6 py-4 first:pl-0 last:pr-0 max-mobile:px-0"> <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-cyan/20 text-sea-dark"><svg class="shrink-0 size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">   <circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path> </svg></span> <div> <h3 class="text-[1rem]">Supplies included</h3> <p class="mt-1 max-w-[330px] text-[.9rem] leading-[1.5]">Tell us about delicate surfaces or product preferences.</p> </div> </article><article class="flex gap-3 px-6 py-4 first:pl-0 last:pr-0 max-mobile:px-0"> <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-cyan/20 text-sea-dark"><svg class="shrink-0 size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">   <circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path> </svg></span> <div> <h3 class="text-[1rem]">Access arranged</h3> <p class="mt-1 max-w-[330px] text-[.9rem] leading-[1.5]">You can be home or out; we’ll agree on access beforehand.</p> </div> </article> </div> <div class="flex min-w-max flex-col items-start gap-2 max-tablet:min-w-0 max-tablet:flex-row max-tablet:flex-wrap max-tablet:gap-x-6"> <a class="inline-flex min-h-11 items-center gap-control-gap text-link font-[750] text-sea-dark underline underline-offset-4" href="/faq/">Getting ready for your clean <svg class="shrink-0 size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"> <path d="M4 12h16m-6-6 6 6-6 6"></path>   </svg></a> <a class="text-small font-[650] text-sea-dark underline underline-offset-4" href="/about/">How we work</a> </div> </div> </section> <section class="bg-ocean py-[78px] text-white max-mobile:py-14" aria-labelledby="process-heading"> <div class="mx-auto w-[min(calc(100%-40px),1180px)] max-mobile:w-[min(calc(100%-28px),1180px)] group-[.island-home]/site:max-mobile:w-[calc(100%-36px)]"> <div class="mb-10 grid grid-cols-[.65fr_1fr] items-end gap-10 max-mobile:grid-cols-1 max-mobile:gap-3"> <div> <p class="mb-4 flex items-center gap-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-cyan"><span class="h-px w-10 bg-cyan" aria-hidden="true"></span>How it works</p> <h2 id="process-heading" class="max-w-[650px] text-white">Getting a clean on the calendar is simple.</h2> </div> <p class="max-w-[540px] justify-self-end text-[1.02rem] leading-[1.65] text-white/70 max-mobile:justify-self-start">A quote request starts the conversation. Your appointment is confirmed separately.</p> </div> <ol class="m-0 grid list-none grid-cols-3 gap-8 p-0 max-tablet:grid-cols-1 max-tablet:gap-8" role="list"> <li class="border-t border-white/20 pt-6"> <span class="mb-6 block h-1.5 w-12 rounded-full bg-cyan" aria-hidden="true"></span> <h3 class="mb-3 text-[1.25rem] text-white">Tell Us What You Need</h3> <p class="max-w-[320px] text-small leading-[1.6] text-white/70">Send your location, the type of cleaning you need, and the dates that work for you.</p> </li><li class="border-t border-white/20 pt-6"> <span class="mb-6 block h-1.5 w-12 rounded-full bg-cyan" aria-hidden="true"></span> <h3 class="mb-3 text-[1.25rem] text-white">Work Out the Details</h3> <p class="max-w-[320px] text-small leading-[1.6] text-white/70">Review the cleaning tasks, price, and available dates with us before you book.</p> </li><li class="border-t border-white/20 pt-6"> <span class="mb-6 block h-1.5 w-12 rounded-full bg-cyan" aria-hidden="true"></span> <h3 class="mb-3 text-[1.25rem] text-white">Come Back to a Clean Space</h3> <p class="max-w-[320px] text-small leading-[1.6] text-white/70">We handle the cleaning we agreed on. If something needs attention afterward, call or text us and let us know.</p> </li> </ol> </div> </section> <section class="py-[82px] max-mobile:py-14" aria-labelledby="rental-heading"> <div class="mx-auto w-[min(calc(100%-40px),1180px)] max-mobile:w-[min(calc(100%-28px),1180px)] group-[.island-home]/site:max-mobile:w-[calc(100%-36px)] grid grid-cols-[1.16fr_.84fr] items-center gap-14 max-tablet:grid-cols-1 max-tablet:gap-8"> <div class="overflow-hidden rounded-panel bg-mist"> <img class="aspect-[1.42] w-full object-cover object-[center_60%] max-mobile:aspect-[1.7]" src="/images/rental-bedroom.jpg" width="1000" height="1000" alt="Guest-ready bedroom prepared for the next vacation-rental stay" loading="lazy"> </div> <div> <p class="mb-[17px] text-eyebrow font-extrabold uppercase tracking-[.11em] text-sea-dark max-mobile:mb-3 max-mobile:text-eyebrow-mobile max-mobile:tracking-[.06em] flex items-center gap-3"><span class="h-px w-10 bg-sea" aria-hidden="true"></span>For hosts &amp; property managers</p> <h2 id="rental-heading" class="max-w-[520px]">Keep the turnover moving between guests.</h2> <p class="mt-5 max-w-[520px] text-[1.06rem] leading-[1.68]">Send the checkout and check-in times along with the property routine. We’ll work out the cleaning checklist, linens, restocking, and access, then provide completion photos after each turnover.</p> <p class="mt-5 font-bold text-sea-dark">From $125 per turnover</p> <p class="mt-3 max-w-[520px] text-small">Includes turnover cleaning and beds reset with provided clean linens. Laundry and supply restocking are quoted separately.</p> <a class="inline-flex min-h-11 items-center gap-control-gap text-link font-[750] text-sea-dark underline underline-offset-4 mt-5" href="/vacation-rental-cleaning/">See turnover pricing &amp; details <svg class="shrink-0 size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"> <path d="M4 12h16m-6-6 6 6-6 6"></path>   </svg></a> </div> </div> </section> <section class="border-y border-line bg-seafoam py-11 max-mobile:py-9" aria-labelledby="contact-heading"> <div class="mx-auto w-[min(calc(100%-40px),1180px)] max-mobile:w-[min(calc(100%-28px),1180px)] group-[.island-home]/site:max-mobile:w-[calc(100%-36px)] flex items-center justify-between gap-7 max-tablet:flex-col max-tablet:items-start"> <div> <p class="mb-3 text-eyebrow font-extrabold uppercase tracking-[.12em] text-sea-dark">Ready when you are</p> <h2 id="contact-heading">Ready to get the cleaning off your list?</h2> <p class="mt-3 max-w-[520px]">Send a quote request, or call or text us about the property and the dates you have in mind.</p> </div> <div class="flex shrink-0 flex-wrap items-center gap-[18px] max-mobile:gap-x-[14px] max-mobile:gap-y-[7px]"> <a href="/quote/" class="inline-flex items-center justify-center gap-control-gap rounded-lg border no-underline transition-[transform,background,border-color] duration-200 motion-safe:not-disabled:hover:-translate-y-0.5 motion-safe:active:translate-y-0 disabled:cursor-wait disabled:opacity-70 border-transparent bg-sea-dark text-white shadow-[0_8px_22px_rgba(0,101,145,.16)] hover:bg-teal active:bg-teal min-h-[50px] px-control-x text-action font-extrabold">Get a Quote<svg class="shrink-0 size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"> <path d="M4 12h16m-6-6 6 6-6 6"></path>   </svg></a> <a class="text-label font-[650] text-sea-dark underline underline-offset-4" href="tel:+13213239776">Call (321) 323-9776</a> </div> </div> </section>  </main> <footer class="footer bg-footer pt-7 pb-5 text-white group-[.island-home]/site:bg-footer max-mobile:pt-6 max-mobile:pb-[calc(64px+env(safe-area-inset-bottom))] group-[.no-mobile-bar]/site:max-mobile:pb-[max(20px,env(safe-area-inset-bottom))]"> <div class="mx-auto w-[min(calc(100%-40px),1180px)] max-mobile:w-[min(calc(100%-28px),1180px)] group-[.island-hom